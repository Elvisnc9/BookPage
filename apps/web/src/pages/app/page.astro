---
import type { OwnerBusiness } from '@bookpage/shared';
import MyPage from '../../components/onboarding/MyPage';
import '../../components/onboarding/onboarding.css';
import AppLayout from '../../layouts/AppLayout.astro';
import { apiFetch } from '../../lib/api';

// My page: edit services, hours and booking rules. Middleware guarantees a published business.
const res = await apiFetch('/business', Astro);
if (!res.ok) throw new Error(`GET /business failed: ${res.status}`);
const { business } = (await res.json()) as { business: OwnerBusiness };
---

<AppLayout title="My page" active="page" timezone={business.timezone}>
  <MyPage client:load initial={business} tab={Astro.url.searchParams.get('tab') ?? 'services'} />
</AppLayout>

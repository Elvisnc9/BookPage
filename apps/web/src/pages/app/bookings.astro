---
import BookingsBoard from '../../components/dashboard/BookingsBoard.astro';
import Skeleton from '../../components/dashboard/Skeleton.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import { flash, handleBookingAction } from '../../lib/owner';

/** All bookings, by view: upcoming, needs OK, past, cancelled. The list streams in (BookingsBoard). */
const action = await handleBookingAction(Astro);
if (action) return action;

const params = Astro.url.searchParams;
const view = params.get('view') ?? 'upcoming';
const q = (params.get('q') ?? '').trim().slice(0, 80);
---

<AppLayout title="Bookings" active="bookings">
  <div class="ap-head">
    <h1 class="ap-h1">Bookings</h1>
  </div>

  <BookingsBoard server:defer view={view} q={q} message={flash(Astro.url)}>
    <Skeleton slot="fallback" variant="list" label="Loading bookings…" />
  </BookingsBoard>
</AppLayout>

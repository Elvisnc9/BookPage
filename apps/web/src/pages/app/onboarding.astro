---
import type { OwnerBusiness, SiteTemplate } from '@bookpage/shared';
import { ROOT_DOMAIN } from 'astro:env/server';
import Onboarding from '../../components/onboarding/Onboarding';
import '../../site/index.css';
import '../../components/onboarding/onboarding.css';
import Base from '../../layouts/Base.astro';
import { apiFetch } from '../../lib/api';

// Reached only via the app-host rewrite in middleware.ts, which guarantees `me`.
const { business: summary } = Astro.locals.me!;
if (summary?.publishedAt) return Astro.redirect('/', 303);

// The business draft and the template gallery (active, validated rows from the database).
const [bizRes, tplRes] = await Promise.all([apiFetch('/business', Astro.request), apiFetch('/templates', Astro.request)]);
if (!bizRes.ok) throw new Error(`GET /business failed: ${bizRes.status}`);
if (!tplRes.ok) throw new Error(`GET /templates failed: ${tplRes.status}`);
const { business } = (await bizRes.json()) as { business: OwnerBusiness | null };
const { templates } = (await tplRes.json()) as { templates: SiteTemplate[] };

const origin = { protocol: Astro.url.protocol, rootDomain: ROOT_DOMAIN, port: Astro.url.port };
---

<Base title="Set up your page · BookPage">
  <main class="ob-root">
    <Onboarding client:load initial={business} templates={templates} origin={origin} />
  </main>
</Base>

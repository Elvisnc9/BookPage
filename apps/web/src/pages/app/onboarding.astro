---
import type { OwnerBusiness } from '@bookpage/shared';
import { ROOT_DOMAIN } from 'astro:env/server';
import Onboarding from '../../components/onboarding/Onboarding';
import '../../components/onboarding/onboarding.css';
import Base from '../../layouts/Base.astro';
import { apiFetch } from '../../lib/api';

// Reached only via the app-host rewrite in middleware.ts, which guarantees `me`.
const { business: summary } = Astro.locals.me!;
if (summary?.publishedAt) return Astro.redirect('/', 303);

const res = await apiFetch('/business', Astro.request);
if (!res.ok) throw new Error(`GET /business failed: ${res.status}`);
const { business } = (await res.json()) as { business: OwnerBusiness | null };

const origin = { protocol: Astro.url.protocol, rootDomain: ROOT_DOMAIN, port: Astro.url.port };
---

<Base title="Set up your page · BookPage">
  <header class="ob-top">
    <a class="ob-brand mono" href="/">BookPage</a>
    <form method="post" action="/api/auth/logout">
      <button class="btn ob-signout" type="submit">Sign out</button>
    </form>
  </header>
  <main>
    <Onboarding client:load initial={business} origin={origin} />
  </main>
</Base>

---
import { SignIn } from '@clerk/astro/components';
import ClerkScript from '../../components/ClerkScript.astro';
import Base from '../../layouts/Base.astro';
import { siteLinks } from '../../lib/marketing';

// One form for new and returning owners (Google, or email + one-time code, no passwords).
// Both land on "/", where middleware sends new owners to onboarding. ?new only changes the heading.
const isNew = Astro.url.searchParams.has('new');
const { home } = siteLinks(Astro.url);
// Middleware only renders this page signed in when the API refused the account.
const refused = Boolean(Astro.locals.auth().userId);

// Clerk's form rendered straight into our card: no inner card, header or footer,
// and our neobrutalist controls (black borders, hard offset shadows).
const INK = '#0D0D10';
const button = {
  minHeight: '48px',
  border: `2px solid ${INK} !important`,
  borderRadius: '6px',
  boxShadow: `3px 3px 0 ${INK} !important`,
  fontWeight: 600,
  transition: 'transform 140ms cubic-bezier(.23, 1, .32, 1), box-shadow 140ms cubic-bezier(.23, 1, .32, 1)',
  '&:active': { transform: 'translate(2px, 2px)', boxShadow: `1px 1px 0 ${INK} !important` },
  '@media (hover: hover) and (pointer: fine)': { '&:hover': { transform: 'translate(-1px, -1px)', boxShadow: `4px 4px 0 ${INK} !important` } },
};
const appearance = {
  layout: { socialButtonsPlacement: 'top', socialButtonsVariant: 'blockButton', unsafe_disableDevelopmentModeWarnings: true },
  variables: { colorPrimary: INK, colorText: INK, colorTextSecondary: '#5C5C66', colorBackground: '#FFFFFF', colorInputBackground: '#FFFFFF', borderRadius: '6px', fontFamily: 'inherit', fontSize: '15px' },
  elements: {
    rootBox: { width: '100%' },
    cardBox: { width: '100%', maxWidth: 'none', boxShadow: 'none !important', border: 'none', borderRadius: 0, background: 'transparent' },
    card: { boxShadow: 'none !important', border: 'none', borderRadius: 0, background: 'transparent', padding: 0, gap: '20px' },
    header: { display: 'none' },
    footer: { display: 'none' },
    socialButtonsBlockButton: { ...button, background: '#FFFFFF', color: INK },
    socialButtonsBlockButtonText: { fontSize: '15px', fontWeight: 600 },
    dividerLine: { background: '#D7D6D0' },
    formFieldLabel: { fontWeight: 600, color: INK },
    formFieldInput: { minHeight: '48px', border: `2px solid ${INK} !important`, borderRadius: '6px', boxShadow: 'none !important', fontSize: '16px', '&:focus': { boxShadow: `3px 3px 0 ${INK} !important`, borderColor: `${INK} !important` } },
    formButtonPrimary: { ...button, background: INK, color: '#FFFFFF', boxShadow: '3px 3px 0 #E9B949 !important', textTransform: 'none', fontSize: '15px', '&:active': { transform: 'translate(2px, 2px)', boxShadow: '1px 1px 0 #E9B949 !important' }, '@media (hover: hover) and (pointer: fine)': { '&:hover': { background: INK, transform: 'translate(-1px, -1px)', boxShadow: '4px 4px 0 #E9B949 !important' } } },
    otpCodeFieldInput: { border: `2px solid ${INK} !important`, borderRadius: '6px' },
    formResendCodeLink: { color: INK, fontWeight: 600 },
    identityPreviewEditButton: { color: INK },
  },
};

const copy = isNew
  ? { kicker: 'Free forever · no card', t1: 'Get', t2: 'bookings', sub: 'Continue with Google or your email. Your free booking page is about four minutes away.' }
  : { kicker: 'Sign in', t1: 'Welcome', t2: 'back', sub: 'Use the Google account or email you signed up with. Your bookings are waiting.' };
---

<Base title="Sign in · BookPage">
  <main class="si">
    <div class="wrap">
      <a class="brand" href="/" aria-label="BookPage home">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="9" height="9" rx="2" fill="#0D0D10" /><rect x="13" y="13" width="9" height="9" rx="2" fill="#0D0D10" /><rect x="13" y="2" width="9" height="9" rx="2" fill="#F7D45C" stroke="#0D0D10" stroke-width="1.6" /></svg>
        <span class="mono">BOOKPAGE</span>
      </a>

      <section class="box raised card" aria-labelledby="title">
        <p class="lab">{copy.kicker}</p>
        <h1 id="title" class="h-display">{copy.t1} <span class="scan">{copy.t2}</span></h1>
        <p class="sub">{copy.sub}</p>

        {refused ? (
          <>
            <p class="error" role="alert">We couldn't open your BookPage account with this sign-in. Make sure your email address is verified, or sign out and use the account you signed up with.</p>
            <button class="btn btn-ink" type="button" data-sign-out>Sign out</button>
          </>
        ) : (
          <div class="clerk">
            <div class="clerk-wait" aria-hidden="true">
              <span class="cw-btn"></span><span class="cw-or"></span><span class="cw-label"></span><span class="cw-input"></span><span class="cw-btn cw-ink"></span>
            </div>
            {/* One form for everyone: an email Clerk doesn't know continues as a sign-up. */}
            <SignIn routing="hash" withSignUp forceRedirectUrl="/" signUpForceRedirectUrl="/" appearance={appearance} />
            {!isNew && <p class="newhere">New here? Just continue. Your booking page is about four minutes away.</p>}
          </div>
        )}
      </section>

      <p class="legal">
        By continuing you agree to the <a href={`${home}/terms`}>Terms</a> and <a href={`${home}/privacy`}>Privacy Policy</a>.
      </p>
    </div>

    <!-- Wide screens: a still of the product (an illustration, hidden from assistive tech). -->
    <aside class="art" aria-hidden="true">
      <span class="art-sun"></span>
      <span class="art-block"></span>
      <p class="art-line">Your bookings,<br />while you work.</p>
      <div class="box art-today">
        <div class="art-today-head">
          <b>Today</b>
          <span class="pill" data-tone="ok">3 booked</span>
        </div>
        <div class="art-row">
          <span class="avatar" data-hue="1">AM</span>
          <span><b>Ada M.</b><small>Silk press</small></span>
          <span class="mono">10:30</span>
        </div>
        <div class="art-row">
          <span class="avatar" data-hue="3">JR</span>
          <span><b>Jordan R.</b><small>Knotless braids</small></span>
          <span class="mono">13:00</span>
        </div>
        <div class="art-row">
          <span class="avatar" data-hue="2">SK</span>
          <span><b>Sam K.</b><small>Trim</small></span>
          <span class="pill" data-tone="wait">Needs OK</span>
        </div>
      </div>
      <div class="box art-toast">
        <span class="art-tick">✓</span>
        <span><small class="mono">New booking</small><b>Sat 10:30 · Silk press</b></span>
      </div>
    </aside>
  </main>
  <ClerkScript />
  <script>
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-sign-out]')) {
      button.addEventListener('click', () => {
        const clerk = (window as { Clerk?: { signOut: (o: { redirectUrl: string }) => Promise<unknown> } }).Clerk;
        if (clerk) void clerk.signOut({ redirectUrl: '/sign-in' });
      });
    }
  </script>
</Base>

<style>
  .si { min-height: 100dvh; display: grid; grid-template-columns: minmax(0, 1fr); }
  .wrap {
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
    padding: 24px 16px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
  }
  .brand {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    letter-spacing: .04em;
    color: var(--ink);
    text-decoration: none;
  }
  .card { padding: 28px 24px; display: grid; gap: 14px; }
  .card .lab { margin: 0; }
  h1 { font-size: clamp(40px, 12vw, 56px); margin: 0; }
  .sub { margin: 0; color: var(--muted); }
  .error {
    margin: 0;
    padding: 10px 12px;
    background: var(--tint-red);
    border: var(--border);
    border-radius: var(--r);
    font-size: 14px;
  }
  /* Clerk's form, inside our card: reserve its height so the page doesn't jump while it loads. */
  .clerk { min-height: 340px; display: grid; justify-items: stretch; }
  .clerk :global(.cl-rootBox), .clerk :global(.cl-cardBox) { width: 100%; max-width: none; }
  /* Until Clerk's form mounts, its shape holds the space (no blank card, no jump). */
  .newhere { margin: 4px 0 0; font-size: 13px; color: var(--muted); text-align: center; }
  .clerk-wait { display: grid; gap: 12px; padding: 8px 0; }
  .clerk:has(:global(.cl-rootBox)) .clerk-wait { display: none; }
  .clerk:has(:global(.cl-rootBox)) :global(.cl-rootBox) { animation: cw-in 200ms var(--ease-out) both; }
  @keyframes cw-in { from { opacity: 0; transform: translateY(4px); } }
  @keyframes cw-sweep { from { background-position: 150% 0; } to { background-position: -50% 0; } }
  .clerk-wait span { display: block; border-radius: var(--r); background: linear-gradient(90deg, var(--line) 0%, var(--surface-2) 50%, var(--line) 100%) 0 0 / 200% 100%; opacity: .55; animation: cw-sweep 1.4s linear infinite; }
  .cw-btn { height: 44px; }
  .cw-or { height: 10px; width: 40%; justify-self: center; }
  .cw-label { height: 10px; width: 30%; }
  .cw-input { height: 44px; }
  .cw-ink { opacity: .8 !important; }
  @media (prefers-reduced-motion: reduce) { .clerk-wait span { animation: none; } }
  .note { margin: 0; font-size: 13px; color: var(--muted); }
  .legal { margin: 0; font-size: 12px; color: var(--muted); text-align: center; }
  .legal a { color: var(--muted); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  /* The product still: wide screens only. */
  .art { display: none; }
  @media (min-width: 960px) {
    .si { grid-template-columns: minmax(440px, 1fr) minmax(0, 1.1fr); gap: 24px; padding: 24px; }
    .wrap { padding: 24px 16px; }
    .art {
      position: relative;
      display: block;
      min-height: 560px;
      overflow: hidden;
      border: var(--border);
      border-radius: var(--r-xl);
      background: var(--sun) radial-gradient(circle, rgb(13 13 16 / .14) 1.5px, transparent 1.6px) 0 0 / 22px 22px;
      box-shadow: var(--shadow);
    }
    .art-sun { position: absolute; right: -90px; top: -90px; width: 300px; height: 300px; border: var(--border); border-radius: 50%; background: var(--ink); }
    .art-block { position: absolute; left: 8%; bottom: -40px; width: 180px; height: 140px; border: var(--border); border-radius: var(--r-xl); background: var(--peach); rotate: -6deg; }
    .art-line { position: absolute; left: 8%; top: 9%; margin: 0; font-size: clamp(34px, 3.4vw, 52px); font-weight: 900; line-height: .98; letter-spacing: var(--track-tight); }
    .art-today {
      position: absolute; left: 12%; top: 34%; width: min(380px, 66%);
      display: grid; gap: 4px; padding: 16px; box-shadow: var(--shadow); rotate: -2deg;
    }
    .art-today-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 8px; }
    .art-today-head b { font-size: 18px; font-weight: 800; }
    .art-row { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; padding: 10px 0; border-top: 1px solid var(--line-soft); }
    .art-row > span:nth-child(2) { display: grid; line-height: 1.25; }
    .art-row b { font-size: 14px; }
    .art-row small { font-size: 12px; color: var(--muted); }
    .art-row .mono { font-size: 13px; font-weight: 600; }
    .art-toast {
      position: absolute; right: 8%; bottom: 14%;
      display: flex; align-items: center; gap: 12px; padding: 12px 16px 12px 12px;
      box-shadow: var(--shadow-sm); rotate: 3deg;
    }
    .art-toast > span:last-child { display: grid; gap: 2px; }
    .art-toast small { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
    .art-toast b { font-size: 14px; }
    .art-tick { display: grid; place-items: center; width: 34px; height: 34px; border: var(--border); border-radius: var(--r); background: var(--mint); font-weight: 900; }
  }
</style>

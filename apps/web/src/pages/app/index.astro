---
import Skeleton from '../../components/dashboard/Skeleton.astro';
import TodayBoard from '../../components/dashboard/TodayBoard.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import { flash, handleBookingAction } from '../../lib/owner';

// Today: what's on today and what needs the owner's OK. Middleware guarantees a published business.
// The shell renders at once; the data streams in (TodayBoard) and replaces the skeleton.
const action = await handleBookingAction(Astro);
if (action) return action;

const first = (Astro.locals.me!.user.name ?? '').split(' ')[0] ?? '';
---

<AppLayout title="Today" active="today">
  <TodayBoard server:defer first={first} message={flash(Astro.url)}>
    <Skeleton slot="fallback" variant="today" label="Loading today's bookings…" />
  </TodayBoard>
</AppLayout>

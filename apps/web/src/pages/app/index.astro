---
import { addDays, zonedToUtc } from '@bookpage/shared';
import BookingCard from '../../components/BookingCard.astro';
import AppLayout from '../../layouts/AppLayout.astro';
import { flash, getBookings, getSummary, handleBookingAction } from '../../lib/owner';
import { timeOf, whenLabel } from '../../lib/public';

// Today: what's on today and what needs the owner's OK. Middleware guarantees a published business.
const action = await handleBookingAction(Astro);
if (action) return action;

const summary = await getSummary(Astro.request);
const tz = summary.timezone;
const dayStart = zonedToUtc(summary.today, 0, tz);
const dayEnd = zonedToUtc(addDays(summary.today, 1), 0, tz);
const [today, pending] = await Promise.all([
  getBookings(Astro.request, { from: dayStart, to: dayEnd, status: ['pending', 'confirmed', 'completed', 'no_show'] }),
  getBookings(Astro.request, { from: new Date(), status: ['pending'] }),
]);
const message = flash(Astro.url);
const pendingLater = pending.filter((b) => new Date(b.startsAt) >= dayEnd);
const n = summary.todayCount;
---

<AppLayout title="Today" active="today" timezone={tz}>
  <h1 class="h-display ap-h1">{n === 0 ? 'Nothing booked' : `${n} booking${n === 1 ? '' : 's'}`} <span class="scan">today</span></h1>

  {message && <p class={`ap-flash ${message.tone}`} role="status">{message.text}</p>}

  <div class="ap-kpis">
    <div class="box ap-kpi"><span class="lab">Today</span><strong class="mono">{summary.todayCount}</strong></div>
    <div class="box ap-kpi"><span class="lab">This week</span><strong class="mono">{summary.weekCount}</strong></div>
    <a class={`box ap-kpi${summary.pendingCount ? ' ap-kpi-alert' : ''}`} href="/bookings?view=pending">
      <span class="lab">Needs your OK</span><strong class="mono">{summary.pendingCount}</strong>
    </a>
    <div class="box ap-kpi">
      <span class="lab">Next up</span>
      <strong class="ap-kpi-next">{summary.next ? `${timeOf(summary.next.startsAt, tz)} · ${summary.next.customer.name}` : '—'}</strong>
    </div>
  </div>

  <section class="ap-section" aria-labelledby="sched">
    <h2 id="sched" class="ap-h2">Today's schedule</h2>
    {today.length ? (
      <div class="ap-list">{today.map((b) => <BookingCard booking={b} timezone={tz} />)}</div>
    ) : (
      <p class="ap-empty">No bookings today. Share your page link to fill your diary.</p>
    )}
  </section>

  {pendingLater.length > 0 && (
    <section class="ap-section" aria-labelledby="later">
      <h2 id="later" class="ap-h2">Waiting for your OK</h2>
      <div class="ap-list">
        {pendingLater.map((b) => (
          <div>
            <p class="ap-day mono">{whenLabel(b.startsAt, tz)}</p>
            <BookingCard booking={b} timezone={tz} />
          </div>
        ))}
      </div>
    </section>
  )}
</AppLayout>

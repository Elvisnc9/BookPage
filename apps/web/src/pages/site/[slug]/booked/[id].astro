---
import { formatMoney, type PublicBooking } from '@bookpage/shared';
import BookingLayout from '../../../../layouts/BookingLayout.astro';
import Icon from '../../../../components/booking/Icon.astro';
import { cancelBooking, getBooking, loadBusiness, PublicApiError, price, TOO_MANY_ATTEMPTS, whenLabel } from '../../../../lib/public';

/**
 * Confirmation and self-service page. The secret ?t= token (also in the
 * confirmation email) is what lets the customer see and cancel the booking.
 */
const b = await loadBusiness(Astro.params.slug, Astro.request);
if (b instanceof Response) return b;

const id = Astro.params.id ?? '';
const token = Astro.url.searchParams.get('t') ?? '';
let booking: PublicBooking;
let failure = '';
try {
  try {
    booking = Astro.request.method === 'POST' ? await cancelBooking(b.slug, id, token, Astro.request) : await getBooking(b.slug, id, token, Astro.request);
  } catch (error) {
    if (!(error instanceof PublicApiError && error.tooManyAttempts && Astro.request.method === 'POST')) throw error;
    failure = TOO_MANY_ATTEMPTS;
    booking = await getBooking(b.slug, id, token, Astro.request);
  }
} catch (error) {
  if (error instanceof PublicApiError && (error.status === 404 || error.status === 400)) {
    return new Response('Booking not found', { status: 404 });
  }
  throw error;
}

const first = booking.customerName.split(' ')[0];
const when = whenLabel(booking.startsAt, booking.timezone);
const address = [b.addressLine1, b.city].filter(Boolean).join(', ');
const self = `/booked/${id}?t=${encodeURIComponent(token)}`;
const ics = `/booked/${id}/calendar.ics?t=${encodeURIComponent(token)}`;
const move = `/booked/${id}/reschedule?t=${encodeURIComponent(token)}`;
const moved = Astro.url.searchParams.has('moved') && !failure;
const depositDue = booking.deposit && !booking.deposit.paid ? booking.deposit : null;
const heading = {
  confirmed: { kicker: '✓ You are booked', title: `See you soon, ${first}.` },
  pending: depositDue ? { kicker: 'Deposit to confirm', title: `Almost booked, ${first}.` } : { kicker: 'Request sent', title: `Thanks, ${first}.` },
  cancelled: { kicker: 'Cancelled', title: 'Your booking is cancelled.' },
  completed: { kicker: 'Done', title: `Thanks for visiting, ${first}.` },
  no_show: { kicker: 'Missed', title: 'This booking was marked as missed.' },
}[booking.status];
---

<BookingLayout business={b} title={`${heading.kicker} · ${b.name}`} noReferrer>
  <main class="bk-flow">
    <div class="bk-done" data-status={booking.status}>
      {failure && <p class="bk-alert" role="alert">{failure}</p>}
      {moved && <p class="bk-flash" role="status">Your new time is saved. We've emailed you the details.</p>}
      <p class="bk-badge"><i><Icon name={booking.status === 'cancelled' || booking.status === 'no_show' ? 'undo' : 'check'} size={14} /></i>{heading.kicker.replace('✓ ', '')}</p>
      <h1 class="bk-flow-title">{heading.title}</h1>
      <dl class="bk-receipt">
        <div><dt>What</dt><dd>{booking.serviceName} · {price(booking, booking.currency)}</dd></div>
        <div><dt>When</dt><dd>{when}</dd></div>
        <div><dt>With</dt><dd>{booking.staffName}</dd></div>
        {address && <div><dt>Where</dt><dd>{address}</dd></div>}
      </dl>
      {booking.status === 'pending' && depositDue && (
        <div class="bk-deposit">
          <p class="bk-deposit-title">Pay your {formatMoney(depositDue.amountMinor, booking.currency)} deposit to confirm</p>
          <p class="bk-hint">
            Your time is held until {whenLabel(depositDue.dueAt, booking.timezone)}. {booking.businessName} confirms by email once the deposit arrives.
            {depositDue.refundHours === 0 ? ' Refunded if you cancel before your time.' : ` Refunded if you cancel at least ${depositDue.refundHours} hours before.`}
          </p>
          {depositDue.payUrl
            ? <a class="btn btn-ink" href={depositDue.payUrl} rel="noopener noreferrer" target="_blank">Pay deposit <Icon name="arrow" size={16} /></a>
            : <p class="bk-hint">Contact {booking.businessName}{b.phone ? ` on ${b.phone}` : ''} to pay.</p>}
        </div>
      )}
      {booking.status === 'pending' && !depositDue && (
        <p class="bk-hint">{booking.businessName} will confirm by email. The time is held for you meanwhile.</p>
      )}
      {booking.status === 'confirmed' && booking.deposit?.paid && (
        <p class="bk-hint">Deposit of {formatMoney(booking.deposit.amountMinor, booking.currency)} received.</p>
      )}
      {booking.status === 'confirmed' && <p class="bk-hint">A confirmation is on its way to your email.</p>}

      {booking.cancellable && (
        <div class="bk-actions">
          <a class="btn" href={ics}>Add to calendar</a>
          {booking.reschedulable && <a class="btn" href={move}>Change time</a>}
          <form method="post" action={self}>
            <button class="btn bk-cancel" type="submit">Cancel booking</button>
          </form>
        </div>
      )}
      {booking.status === 'cancelled' && <a class="btn btn-ink" href="/#services">Book another time</a>}
    </div>
    <p class="bk-note">Keep this page's link to change your time or cancel later.</p>
  </main>
</BookingLayout>

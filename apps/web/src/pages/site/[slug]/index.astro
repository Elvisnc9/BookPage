---
import { CATEGORIES, type CategoryKey, formatDuration, formatMinutes, localDate, WEEKDAY_SHORT } from '@bookpage/shared';
import BookingLayout from '../../../layouts/BookingLayout.astro';
import Icon from '../../../components/booking/Icon.astro';
import { initials, loadBusiness, openStatus, price } from '../../../lib/public';

// Reached only via the {slug}. subdomain rewrite in middleware.ts.
const b = await loadBusiness(Astro.params.slug, Astro.request);
if (b instanceof Response) return b;

const category = b.category && b.category in CATEGORIES ? CATEGORIES[b.category as CategoryKey] : null;
const cta = category?.cta ?? 'Book now';
const status = openStatus(b);
const [firstWord, ...rest] = b.name.split(' ');

const onPremises = (b.locationType === 'premises' || b.locationType === 'both') && !!b.addressLine1;
const address = [b.addressLine1, b.addressLine2, b.city, b.region, b.postalCode].filter(Boolean).join(', ');
const area = b.locationType === 'online' ? 'Online' : b.locationType === 'mobile' ? 'Comes to you' : [b.city, b.region].filter(Boolean).join(', ');
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${b.name}, ${address}`)}`;
const tel = b.phone ? `tel:${b.phone}` : null;
const whatsapp = b.whatsapp ? `https://wa.me/${b.whatsapp.replace(/\D/g, '')}` : null;

const range = (h: { opensAt: number; closesAt: number }) =>
  `${formatMinutes(h.opensAt)} – ${h.closesAt === 1440 ? 'Midnight' : formatMinutes(h.closesAt)}`;
const today = localDate(new Date(), b.timezone).weekday;
const hours = WEEKDAY_SHORT.map((d, i) => {
  const ranges = b.hours.filter((h) => h.weekday === i + 1);
  return { d, today: i + 1 === today, t: ranges.length ? ranges.map(range).join(', ') : 'Closed' };
});
const todayHours = hours[today - 1]!;

const href = (s: (typeof b.services)[number], staffId?: string) =>
  s.bookable ? `/book?${new URLSearchParams({ service: s.id, ...(staffId ? { staff: staffId } : {}) })}` : `/enquire?service=${s.id}`;
const featured = b.services.slice(0, 4);
const more = b.services.slice(4);
const lowest = b.services.filter((s) => s.priceType === 'fixed' || s.priceType === 'from').sort((x, y) => x.priceMinor! - y.priceMinor!)[0];

// Who works there, in the business's own words where we can guess them.
const crew = ({ hair_salon: 'stylists', barber: 'barbers', spa: 'therapists', nails_lashes: 'artists', clinic: 'clinicians', tutor: 'tutors', fitness: 'trainers', photography: 'photographers' } as Record<string, string>)[b.category ?? ''] ?? 'team';
const team = b.staff.map((p) => {
  const theirs = b.services.filter((s) => p.serviceIds.includes(s.id));
  const names = theirs.map((s) => s.name);
  return { ...p, first: theirs.find((s) => s.bookable), does: names.slice(0, 2).join(' & ') + (names.length > 2 ? ` +${names.length - 2}` : ''), count: theirs.length };
});

const nav = [
  { href: '#services', label: 'Services' },
  ...(team.length ? [{ href: '#team', label: crew[0]!.toUpperCase() + crew.slice(1) }] : []),
  { href: '#visit', label: onPremises ? 'Location' : 'Contact' },
  ...(b.faqs.length ? [{ href: '#faq', label: 'FAQ' }] : []),
];

const perks = [
  { icon: 'bolt', title: 'Book in 30 seconds', text: 'Pick a time that suits you' },
  { icon: 'wallet', title: 'No payment to book', text: 'Nothing to pay online' },
  { icon: 'bell', title: 'Reminder the day before', text: 'By email, if you want one' },
  { icon: 'undo', title: 'Easy to cancel', text: 'From your confirmation link' },
] as const;
---

<BookingLayout business={b} nav={nav} title={`${b.name} · Book online`} description={b.description ?? `Book ${b.name} online.`}>
  <main>
    <section class="bk-hero" aria-labelledby="name">
      <div class="bk-hero-art" aria-hidden="true">
        <span class="bk-hero-mono">{initials(b.name)}</span>
      </div>
      <div class="bk-wrap bk-hero-in">
        <div class="bk-hero-copy">
          {area && <p class="bk-kicker">{area}</p>}
          <h1 id="name" class="bk-name">
            {rest.length ? <>{firstWord} <span class="bk-outline">{rest.join(' ')}</span></> : b.name}
          </h1>
          {b.description && <p class="bk-tagline">{b.description}</p>}
          <div class="bk-proof">
            {team.length > 0 && (
              <span class="bk-stack" aria-hidden="true">
                {team.slice(0, 4).map((p, i) => <span data-tint={i % 6}>{initials(p.name)}</span>)}
              </span>
            )}
            <span class="bk-status" data-open={status.open}><i aria-hidden="true"></i>{status.text}</span>
          </div>
          <div class="bk-hero-actions">
            <a class="btn btn-ink" href="#services">{cta} <Icon name="arrow" size={16} /></a>
            {whatsapp ? <a class="btn" href={whatsapp}><Icon name="chat" size={16} /> WhatsApp us</a>
              : tel && <a class="btn" href={tel}><Icon name="phone" size={16} /> Call us</a>}
          </div>
        </div>

        {featured.length > 0 && (
          <nav class="bk-strip" aria-label="Popular services">
            {featured.map((s, i) => (
              <a href={href(s)}>
                <span class="bk-thumb" data-tint={i % 6} aria-hidden="true">{initials(s.name)}</span>
                <span>{s.name}</span>
              </a>
            ))}
            <a class="bk-strip-all" href="#services" aria-label="All services"><Icon name="plus" size={18} /></a>
          </nav>
        )}
      </div>
    </section>

    <section class="bk-wrap bk-info" aria-label="At a glance">
      <ul class="bk-facts">
        <li>
          <Icon name="calendar" size={22} />
          <span><small>{todayHours.t === 'Closed' ? 'Closed today' : 'Open today'}</small>{todayHours.t === 'Closed' ? status.text.replace('Closed · ', '') : todayHours.t}</span>
        </li>
        <li>
          <Icon name="pin" size={22} />
          <span><small>{onPremises ? b.addressLine1 : 'Where'}</small>{onPremises ? [b.city, b.region].filter(Boolean).join(', ') : area || 'Ask us'}</span>
        </li>
        {b.phone && (
          <li class="bk-fact-phone">
            <Icon name="phone" size={22} />
            <span><small>Call us</small><a href={tel!}>{b.phone}</a></span>
          </li>
        )}
        {b.services.length > 0 && (
          <li>
            <Icon name="list" size={22} />
            <span><small>{b.services.length} {b.services.length === 1 ? 'service' : 'services'}</small>{lowest ? `From ${price({ ...lowest, priceType: 'fixed' }, b.currency)}` : 'Book online'}</span>
          </li>
        )}
      </ul>
      <a class="bk-info-cta" href="#services">
        <span class="bk-thumb" data-tint="2" aria-hidden="true">{initials(b.name)}</span>
        <strong>Book your<br />next visit</strong>
        <span class="bk-round" aria-hidden="true"><Icon name="arrow" size={18} /></span>
      </a>
    </section>

    <section id="services" class="bk-wrap bk-sec bk-services" aria-labelledby="services-title">
      <div class="bk-sec-intro">
        <p class="bk-kicker">Services</p>
        <h2 id="services-title" class="bk-h2">Choose your service</h2>
        <p class="bk-lede">Pick what you'd like, then choose a time. It takes about 30 seconds.</p>
      </div>
      {b.services.length ? (
        <ul class="bk-cards">
          {featured.map((s, i) => (
            <li><a class="bk-svc" href={href(s)} data-tint={i % 6}>
              <span class="bk-svc-mono" aria-hidden="true">{initials(s.name)}</span>
              <span class="bk-svc-dur">{s.bookable ? formatDuration(s.durationMin) : 'Ask for a quote'}</span>
              <span class="bk-svc-foot">
                <span><strong>{s.name}</strong><small>{price(s, b.currency)}</small></span>
                <span class="bk-round bk-round-light" aria-hidden="true"><Icon name="arrow" size={16} /></span>
              </span>
            </a></li>
          ))}
        </ul>
      ) : <p class="bk-lede">Services are coming soon.</p>}
      {more.length > 0 && (
        <details class="bk-more">
          <summary class="btn">View all {b.services.length} services <Icon name="arrow" size={16} /></summary>
          <ul class="bk-rows">
            {b.services.map((s) => (
              <li><a class="bk-row" href={href(s)}>
                <span><strong>{s.name}</strong><small>{s.bookable ? formatDuration(s.durationMin) : 'Ask for a quote'}{s.description ? ` · ${s.description}` : ''}</small></span>
                <span class="bk-row-side"><strong>{price(s, b.currency)}</strong><small>{s.bookable ? 'Book' : 'Ask'} <Icon name="arrow" size={14} /></small></span>
              </a></li>
            ))}
          </ul>
        </details>
      )}
    </section>

    <section class="bk-wrap" aria-label="Booking with us">
      <ul class="bk-perks">
        {perks.map((p) => (
          <li><Icon name={p.icon} size={26} /><span><strong>{p.title}</strong><small>{p.text}</small></span></li>
        ))}
      </ul>
    </section>

    <section class="bk-wrap bk-sec bk-cta" aria-labelledby="cta-title">
      <div class="bk-cta-art" data-tint="1">
        <span class="bk-hero-mono" aria-hidden="true">{initials(b.name)}</span>
        <p><strong>Step inside {b.name}</strong>{onPremises ? <span>{[b.addressLine1, b.city].filter(Boolean).join(', ')}</span> : area && <span>{area}</span>}</p>
      </div>
      <div class="bk-cta-card">
        <p class="bk-kicker">Book your visit</p>
        <h2 id="cta-title" class="bk-h2">Let's get you booked</h2>
        <p class="bk-lede">Choose a service, pick a time and you're done. We'll send a confirmation to your email.</p>
        <div class="bk-hero-actions">
          <a class="btn btn-ink" href="#services">{cta} <Icon name="arrow" size={16} /></a>
          <a class="btn" href="/enquire">Ask a question</a>
        </div>
        <a class="bk-round bk-round-peach bk-cta-go" href="#services" aria-label={cta}><Icon name="arrow" size={20} /></a>
      </div>
    </section>

    {team.length > 0 && (
      <section id="team" class="bk-wrap bk-sec" aria-labelledby="team-title">
        <p class="bk-kicker">Meet the team</p>
        <h2 id="team-title" class="bk-h2">Your {crew}</h2>
        <ul class="bk-team">
          {team.map((p, i) => (
            <li class="bk-person">
              <span class="bk-avatar" data-tint={(i + 3) % 6} aria-hidden="true">{initials(p.name)}</span>
              <span class="bk-person-text">
                <strong>{p.name}</strong>
                {p.does && <small>{p.does}</small>}
                <small>{p.count} {p.count === 1 ? 'service' : 'services'}</small>
              </span>
              {p.first && <a class="bk-round" href={href(p.first, p.id)} aria-label={`Book with ${p.name}`}><Icon name="arrow" size={16} /></a>}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section id="visit" class="bk-wrap bk-sec" aria-labelledby="visit-title">
      <p class="bk-kicker">{onPremises ? 'Visit us' : 'Get in touch'}</p>
      <h2 id="visit-title" class="bk-h2">{onPremises ? `Find us${b.city ? ` in ${b.city}` : ''}` : 'Say hello'}</h2>
      <div class="bk-visit">
        <div class="bk-place">
          {onPremises && (
            <div class="bk-map" aria-hidden="true">
              <span class="bk-map-pin"><Icon name="pin" size={30} /></span>
              <span class="bk-map-label">{b.addressLine1}</span>
            </div>
          )}
          <div class="bk-place-text">
            {onPremises ? (
              <>
                <p><strong>{address}</strong></p>
                <a class="btn btn-ink" href={mapsUrl} rel="noopener">Get directions <Icon name="arrow" size={16} /></a>
              </>
            ) : (
              <p><strong>{b.locationType === 'online' ? 'We meet online' : 'We come to you'}</strong></p>
            )}
            {b.serviceAreas.length > 0 && <p><small>We travel to</small>{b.serviceAreas.join(', ')}</p>}
            <ul class="bk-contact">
              {b.phone && <li><Icon name="phone" size={18} /><a href={tel!}>{b.phone}</a></li>}
              {b.email && <li><Icon name="mail" size={18} /><a href={`mailto:${b.email}`}>{b.email}</a></li>}
              {whatsapp && <li><Icon name="chat" size={18} /><a href={whatsapp}>WhatsApp</a></li>}
            </ul>
          </div>
        </div>
        <div class="bk-hours-card">
          <h3>Opening hours</h3>
          <dl class="bk-hours">
            {hours.map((h) => (
              <div data-today={h.today || undefined}><dt>{h.d}{h.today && <span class="bk-sr"> (today)</span>}</dt><dd>{h.t}</dd></div>
            ))}
          </dl>
          <p class="bk-note">Times in {b.timezone.split('/').pop()!.replace(/_/g, ' ')} time</p>
        </div>
      </div>
    </section>

    {b.faqs.length > 0 && (
      <section id="faq" class="bk-wrap bk-sec" aria-labelledby="faq-title">
        <div class="bk-sec-head">
          <div>
            <p class="bk-kicker">FAQ</p>
            <h2 id="faq-title" class="bk-h2">Quick answers</h2>
          </div>
          <a class="bk-link" href="/enquire">Still have questions? <Icon name="arrow" size={14} /></a>
        </div>
        <div class="bk-faqs">
          {b.faqs.map((f) => (
            <details class="bk-faq">
              <summary>{f.question}<Icon name="plus" size={18} /></summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}
  </main>
</BookingLayout>

---
import Base from '../../../layouts/Base.astro';
import { loadBusiness } from '../../../lib/public';
import { buildSite } from '../../../site/model';
import { Site } from '../../../site/Site';
import '../../../site/index.css';

// Reached only via the {slug}. subdomain rewrite in middleware.ts.
// The page is the business's template, server-rendered from the same <Site>
// component the onboarding preview uses. No client directive: it ships no JS.
const b = await loadBusiness(Astro.params.slug, Astro.request);
if (b instanceof Response) return b;

const site = buildSite(b, 'live');
---

<Base title={`${b.name} · Book online`} description={b.description ?? `Book ${b.name} online.`}>
  <Site site={site} />
</Base>

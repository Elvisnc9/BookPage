---
import { formatDuration } from '@bookpage/shared';
import BookingLayout from '../../../layouts/BookingLayout.astro';
import Icon from '../../../components/booking/Icon.astro';
import { dayLabel, getAvailability, initials, loadBusiness, price, timeOf } from '../../../lib/public';

/**
 * Step 1 of booking: pick who and when. Plain links, no JavaScript, so it is
 * fast and works on any phone. ?service=…&staff=…&date=YYYY-MM-DD
 */
const b = await loadBusiness(Astro.params.slug, Astro.request);
if (b instanceof Response) return b;

const q = Astro.url.searchParams;
const service = b.services.find((s) => s.id === q.get('service') && s.bookable);
if (!service) return Astro.redirect('/#services', 303);

const team = b.staff.filter((p) => p.serviceIds.includes(service.id));
const staff = team.find((p) => p.id === q.get('staff')) ?? null;
const days = await getAvailability(b.slug, service.id, staff?.id ?? null, Astro.request, 14);
const firstOpen = days.find((d) => d.slots.length)?.date;
const date = days.some((d) => d.date === q.get('date')) ? q.get('date')! : firstOpen ?? days[0]?.date;
const selected = days.find((d) => d.date === date);
const taken = q.has('taken');

const link = (patch: Record<string, string | null>) => {
  const p = new URLSearchParams({ service: service.id, ...(staff ? { staff: staff.id } : {}), ...(date ? { date } : {}) });
  for (const [k, v] of Object.entries(patch)) v === null ? p.delete(k) : p.set(k, v);
  return `/book?${p}`;
};
const detailsLink = (start: string) =>
  `/details?${new URLSearchParams({ service: service.id, start, ...(staff ? { staff: staff.id } : {}) })}`;
---

<BookingLayout business={b} title={`Book ${service.name} · ${b.name}`} bar={false}>
  <main class="bk-flow">
    <a class="bk-back" href="/#services"><Icon name="back" size={14} /> All services</a>
    <h1 class="bk-flow-title">Pick a time</h1>

    <div class="bk-summary">
      <span class="bk-thumb" data-tint="0" aria-hidden="true">{initials(service.name)}</span>
      <span>
        <strong>{service.name}</strong>
        <small>{formatDuration(service.durationMin)} · {price(service, b.currency)}</small>
      </span>
    </div>

    {taken && <p class="bk-alert" role="alert">Sorry, that time was just taken. Please pick another.</p>}

    <div class="bk-panel">
    {team.length > 1 && (
      <section class="bk-step" aria-labelledby="who">
        <h2 id="who" class="bk-step-title">Who would you like?</h2>
        <div class="bk-chips">
          <a class="chip" aria-current={staff ? undefined : 'true'} href={link({ staff: null })}>Anyone</a>
          {team.map((p) => (
            <a class="chip" aria-current={staff?.id === p.id ? 'true' : undefined} href={link({ staff: p.id })}>{p.name}</a>
          ))}
        </div>
      </section>
    )}

    <section class="bk-step" aria-labelledby="when">
      <h2 id="when" class="bk-step-title">Pick a day</h2>
      <nav class="bk-days" aria-label="Days">
        {days.map((d) => {
          const l = dayLabel(d.date);
          const full = d.slots.length === 0;
          return full ? (
            <span class="bk-day" aria-disabled="true"><span class="mono">{l.weekday}</span><strong>{l.day}</strong><span class="mono">—</span></span>
          ) : (
            <a class="bk-day" href={link({ date: d.date })} aria-current={d.date === date ? 'date' : undefined}
              aria-label={`${l.long}, ${d.slots.length} times free`}>
              <span class="mono">{l.weekday}</span><strong>{l.day}</strong><span class="mono">{l.month}</span>
            </a>
          );
        })}
      </nav>

      <h2 class="bk-step-title">{selected && selected.slots.length ? `Times on ${dayLabel(selected.date).long}` : 'Pick a time'}</h2>
      {selected && selected.slots.length ? (
        <ul class="bk-times">
          {selected.slots.map((s) => (
            <li><a class="bk-time" href={detailsLink(s.start)}>{timeOf(s.start, b.timezone)}</a></li>
          ))}
        </ul>
      ) : (
        <p class="bk-empty">
          {firstOpen ? 'No free times that day. Pick another day above.' : `No free times in the next two weeks.${b.phone ? ` Call ${b.phone} to ask.` : ''}`}
        </p>
      )}
      <p class="bk-note">Times shown in {b.timezone.split('/').pop()!.replace(/_/g, ' ')} time</p>
    </section>
    </div>
  </main>
</BookingLayout>

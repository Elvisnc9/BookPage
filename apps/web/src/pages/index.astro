---
import Hero from '../components/marketing/Hero.astro';
import Pricing from '../components/marketing/Pricing.astro';
import Showcase from '../components/marketing/Showcase.astro';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { listTemplates, siteLinks } from '../lib/marketing';

const links = siteLinks(Astro.url);
const templates = await listTemplates(Astro.request);

const ICON = {
  instagram: 'M7.03.084c-1.277.06-2.149.264-2.911.563-.789.308-1.458.72-2.123 1.388-.665.668-1.075 1.337-1.38 2.127-.296.764-.496 1.637-.552 2.914-.056 1.278-.069 1.688-.063 4.947.006 3.259.021 3.667.083 4.947.061 1.277.264 2.148.563 2.911.308.789.72 1.457 1.388 2.123.668.665 1.337 1.074 2.129 1.38.763.295 1.636.496 2.913.552 1.277.056 1.688.069 4.946.063 3.258-.006 3.668-.021 4.948-.081 1.28-.061 2.147-.265 2.91-.563.789-.309 1.458-.72 2.123-1.388.665-.668 1.074-1.338 1.379-2.129.296-.763.497-1.636.552-2.912.056-1.281.069-1.69.063-4.948-.006-3.258-.021-3.667-.082-4.947-.06-1.28-.264-2.148-.563-2.911-.308-.789-.72-1.457-1.388-2.123C21.298 1.33 20.628.921 19.838.617 19.074.321 18.202.12 16.924.065 15.647.009 15.236-.005 11.977.001 8.718.008 8.31.022 7.03.084m.14 21.693c-1.17-.051-1.805-.245-2.229-.408-.56-.216-.96-.477-1.382-.895-.422-.418-.681-.819-.9-1.378-.164-.423-.362-1.058-.417-2.228-.06-1.264-.072-1.644-.079-4.848-.007-3.204.005-3.583.061-4.848.05-1.169.246-1.805.408-2.228.216-.561.476-.96.895-1.382.419-.422.818-.681 1.378-.9.423-.165 1.058-.361 2.227-.417 1.266-.06 1.645-.072 4.848-.079 3.203-.007 3.584.005 4.85.061 1.169.051 1.805.245 2.228.408.561.216.96.475 1.382.895.422.419.682.818.9 1.379.166.422.362 1.056.417 2.226.06 1.266.074 1.645.08 4.848.006 3.203-.006 3.583-.061 4.848-.051 1.17-.245 1.806-.408 2.23-.216.56-.476.96-.895 1.381-.419.421-.818.681-1.378.9-.423.165-1.058.362-2.226.417-1.266.06-1.645.072-4.85.079-3.204.007-3.582-.006-4.848-.061M16.953 5.586A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.442M5.839 12.012c.007 3.403 2.77 6.156 6.173 6.149 3.403-.006 6.157-2.77 6.151-6.173-.007-3.403-2.771-6.157-6.174-6.15-3.403.007-6.156 2.771-6.15 6.174M8 12.008a4 4 0 1 1 4.008 3.992A3.999 3.999 0 0 1 8 12.008',
  whatsapp: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z',
  facebook: 'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z',
  pin: 'M12 1.5a7.5 7.5 0 0 0-7.5 7.5c0 5.6 7.5 13.5 7.5 13.5s7.5-7.9 7.5-13.5A7.5 7.5 0 0 0 12 1.5zm0 10.2a2.7 2.7 0 1 1 0-5.4 2.7 2.7 0 0 1 0 5.4z',
};

const channels = [
  { n: 'Instagram bio', d: ICON.instagram, c: '#FF0069' },
  { n: 'WhatsApp status', d: ICON.whatsapp, c: '#25D366' },
  { n: 'Facebook page', d: ICON.facebook, c: '#0866FF' },
  { n: 'Google listing', d: ICON.pin, c: '#4285F4' },
];

const forCustomers = [
  'See services, prices and real free times before they come',
  'Pick a time that is actually free, day or night',
  'No app, no account, no password',
  'A confirmation now and a reminder the day before',
];
const forOwners = [
  'Every booking emailed to you the moment it happens',
  'Approve requests yourself, or let them confirm automatically',
  'Reminders that cut no-shows',
  "Today's schedule on your phone",
];

// A four-point sparkle for the marquee strips.
const STAR = 'M12 1l2.6 8.4L23 12l-8.4 2.6L12 23l-2.6-8.4L1 12l8.4-2.6z';

const stories = [
  { q: 'Saturday bookings stop living in your DMs. Clients tap the link in your bio and pick a free time, even at midnight.', n: 'Hair salons', r: 'SILK PRESS · BRAIDS · COLOUR', tag: 'SALON', stat: 'BOOKED WHILE YOU SLEEP', bg: '#FFFFFF', fg: '#0D0D10', w: 440, rot: -2, big: true, acc: '#E9B949', ini: 'HS' },
  { q: 'Set it up between two clients. Your page is live before the next fade.', n: 'Barbers', r: 'FADES · BEARDS · KIDS CUTS', tag: 'BARBER', stat: 'LIVE IN ABOUT 5 MIN', bg: '#E9B949', fg: '#0D0D10', w: 300, rot: 3, big: false, acc: '#FFFFFF', ini: 'BA' },
  { q: 'Patients see real free times and grab the morning slot without phoning the front desk.', n: 'Clinics & physios', r: 'CHECK-UPS · ASSESSMENTS', tag: 'CLINIC', stat: 'NO MORE PHONE TAG', bg: '#0D0D10', fg: '#F2F2F3', w: 320, rot: -3, big: false, acc: '#C8553D', ini: 'CP' },
  { q: 'Parents book a trial lesson themselves. You just show up and teach.', n: 'Tutors & coaches', r: 'LESSONS · SESSIONS', tag: 'TUTOR', stat: 'TRIAL LESSONS, SORTED', bg: '#FCE9DC', fg: '#0D0D10', w: 300, rot: 2, big: false, acc: '#E07A3F', ini: 'TC' },
  { q: 'Prices sit right on the page, so nobody is surprised at the door.', n: 'Spas & massage', r: 'MASSAGE · FACIALS', tag: 'SPA', stat: 'PRICES UP FRONT', bg: '#FFFFFF', fg: '#0D0D10', w: 300, rot: -1.5, big: false, acc: '#E07A3F', ini: 'SM' },
  { q: 'A reminder goes out the day before, so people actually turn up.', n: 'Photographers', r: 'MINI SHOOTS · PORTRAITS', tag: 'PHOTO', stat: 'DAY-BEFORE REMINDERS', bg: '#C8553D', fg: '#FFFFFF', w: 320, rot: 2.5, big: false, acc: '#E9B949', ini: 'PH' },
  { q: 'It looks like you paid a designer. You paid nothing.', n: 'Nail & lash studios', r: 'GEL SETS · LASH LIFTS', tag: 'NAILS', stat: 'FREE PLAN', bg: '#FBF3DC', fg: '#0D0D10', w: 280, rot: -2.5, big: false, acc: '#C8553D', ini: 'NL' },
];
const dark = (bg: string) => bg === '#0D0D10' || bg === '#C8553D';
const onAccent = (c: string) => (c === '#E9B949' || c === '#FFFFFF' ? '#0D0D10' : '#FFFFFF');

const rowA = [
  ['Hair salons', 'SILK PRESS · $85', '#C8553D', '✂'], ['Barbers', 'SKIN FADE · €25', '#E9B949', '✂'], ['Clinics', 'CHECK-UP · $60', '#E07A3F', '+'],
  ['Tutors', 'TRIAL LESSON · FREE', '#0D0D10', 'A'], ['Spas', 'MASSAGE · €70', '#C8553D', '✿'], ['Photographers', 'MINI SHOOT · $150', '#E07A3F', '◉'],
  ['Nail studios', 'GEL SET · €35', '#E9B949', '✦'], ['Dog groomers', 'FULL GROOM · $65', '#C8553D', '◆'], ['Physios', 'ASSESSMENT · €55', '#0D0D10', '+'],
  ['Lash studios', 'CLASSIC SET · $120', '#E07A3F', '✦'],
];
const rowB = [
  ['Personal trainers', 'PT SESSION · €40', '#E9B949', '▲'], ['Dentists', 'CLEANING · $90', '#C8553D', '+'], ['Brow bars', 'BROW LAMI · €45', '#E07A3F', '✦'],
  ['Music teachers', 'PIANO LESSON · $50', '#0D0D10', '♪'], ['Tattoo studios', 'CONSULT · FREE', '#E9B949', '✎'], ['Yoga studios', 'DROP-IN · €15', '#C8553D', '◉'],
  ['Mechanics', 'OIL CHANGE · $70', '#E07A3F', '⚙'], ['Driving instructors', 'LESSON · €45', '#E9B949', '▲'], ['Massage therapists', '60 MIN · $95', '#0D0D10', '✿'],
  ['Cleaners', 'HOME CLEAN · €60', '#C8553D', '⌂'],
];

const faqs = [
  ['Do my customers need to download anything?', 'No. Your page is an ordinary web link. They open it, pick a time, enter their name and email, and they are booked. No app, no account.'],
  ['How does BookPage know when I am free?', 'From your opening hours, the bookings you already have and your rules, like minimum notice. It only offers times that fit the whole service. Google Calendar sync is on the way.'],
  ['Can two people book the same time?', 'No. Every booking is checked again at the moment it is made, and the database itself refuses an overlapping one. If someone just took a time, the next customer is asked to pick another.'],
  ['Can I approve bookings before they are confirmed?', 'Yes. Turn off automatic confirmation and new bookings wait for your OK. The time is held while you decide, and the customer is emailed either way.'],
  ['What do my customers receive?', 'A confirmation email with a link to change or cancel and add the booking to their calendar, plus a reminder the day before if they want one.'],
  ['What does it cost?', 'Taking bookings is free, with no limit on bookings. Pro, at $15 a month, adds more looks and your own branding. It is opening soon; join the waitlist to hear first.'],
  ['What happens to my customers’ details?', 'They are used only to run your bookings: confirmations, reminders and your dashboard. We never sell them, and we delete them on request.'],
];
---

<MarketingLayout title="BookPage · Never miss a booking" description="A free booking page for your local business. Customers see your services, prices and real free times, and book in under a minute.">
  <Hero />

  <!-- Channels -->
  <section class="mk-fx mk-white mk-channels" aria-label="Where to share your link">
    <div class="mk-w mk-channels-in">
      <span class="lab">Share it where your customers already are</span>
      <ul>
        {channels.map((c) => (
          <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d={c.d} fill={c.c} /></svg>{c.n}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Strip: the whole job in four words -->
  <div class="mk-strip" style="--strip:var(--mint)" aria-hidden="true">
    <div class="mk-strip-track">
      {[0, 1].map(() => ['Add your services', 'Set your hours', 'Share your link', 'Get booked'].map((w) => (
        <span>{w}<svg viewBox="0 0 24 24"><path d={STAR} /></svg></span>
      )))}
    </div>
  </div>

  <!-- How it works -->
  <section id="how" class="mk-fx mk-sec mk-how" aria-labelledby="how-title">
    <div class="mk-w">
      <div class="mk-how-head" data-reveal>
        <h2 id="how-title" class="mk-cond mk-big">Set up once.<br />Get booked.</h2>
        <div class="mk-how-aside">
          <p class="mk-sub">Three steps for you, about five minutes on your phone. One minute for your customers, any time of day.</p>
          <a class="btn btn-ink" href={links.signUp}>Start step one →</a>
        </div>
      </div>
      <svg class="mk-doodle mk-how-doodle" viewBox="0 0 220 120" aria-hidden="true"><path d="M8 20c40-14 70 4 62 34s-40 22-30-4 64-38 92-6 22 52 68 56" /><path d="M188 92l14 10-16 8" /></svg>
      <ol class="mk-how-cards" data-reveal>
        <li class="box mk-hc" style="--bg:var(--surface);--rot:-4deg">
          <span class="mk-hc-top"><span class="mk-hc-ic" style="--ic:var(--sun)"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10" /></svg></span><span class="mono">Step 01</span></span>
          <h3 class="mk-cond">Add your business</h3>
          <p>Services, prices and opening hours. About five minutes, on your phone.</p>
          <span class="mk-hc-ui">
            <span class="mk-row mono"><span>Silk press</span><span>$85</span></span>
            <span class="mk-row mono"><span>Knotless braids</span><span>$180</span></span>
          </span>
        </li>
        <li class="box mk-hc" style="--bg:var(--peach);--rot:3deg">
          <span class="mk-hc-top"><span class="mk-hc-ic" style="--ic:var(--surface)"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="3" /><path d="M3 10h18M8 3v4M16 3v4M8.5 15.5l2.5 2.5 4.5-5" /></svg></span><span class="mono">Step 02</span></span>
          <h3 class="mk-cond">Set your rules</h3>
          <p>Notice, how far ahead, approve or auto-confirm. Only free times are offered, so no double bookings.</p>
          <span class="mk-hc-ui mk-hc-toggle">
            <span><b>Auto-confirm</b><small class="mono">2 hours notice</small></span>
            <span class="mk-toggle" data-on></span>
          </span>
        </li>
        <li class="box mk-hc" style="--bg:var(--periwinkle);--rot:-2deg">
          <span class="mk-hc-top"><span class="mk-hc-ic" style="--ic:var(--sun)"><svg viewBox="0 0 24 24"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg></span><span class="mono">Step 03</span></span>
          <h3 class="mk-cond">Share your link</h3>
          <p>In your Instagram bio, WhatsApp status and Google listing. Customers book from there.</p>
          <span class="mk-hc-ui"><span class="mk-url mono">glowstudio.bookpage.app</span></span>
        </li>
      </ol>
    </div>
  </section>

  <!-- Both sides -->
  <section class="mk-fx mk-sec mk-duo-sec" aria-labelledby="sides-title">
    <div class="mk-w">
      <h2 id="sides-title" class="mk-cond mk-big mk-center" data-reveal>Made for both sides<br />of the counter</h2>
      <div class="mk-duo" data-reveal>
        <div class="box mk-duo-card" style="--rot:-2.5deg">
          <span class="mk-duo-tag mono">Your customers</span>
          <span class="mk-duo-title">Book in a minute, any time of day.</span>
          <ul class="mk-ticks">{forCustomers.map((x) => <li>{x}</li>)}</ul>
        </div>
        <span class="mk-duo-mid" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 9h15l-4-4M20 15H5l4 4" /></svg></span>
        <div class="box mk-duo-card mk-duo-dark" style="--rot:2deg">
          <span class="mk-duo-tag mono">You, the owner</span>
          <span class="mk-duo-title">Stop answering “are you free Saturday?” all day.</span>
          <ul class="mk-ticks">{forOwners.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Your own link -->
  <section class="mk-fx mk-link-sec" aria-labelledby="link-title">
    <div class="mk-w mk-link">
      <div class="mk-link-copy" data-reveal>
        <h2 id="link-title" class="mk-cond mk-big">Claim your link</h2>
        <p class="mk-sub">Type your business name. That is your booking page address, and it's free.</p>
      </div>
      <div class="mk-link-box" data-reveal>
        <form class="box mk-slug" action={links.signUp} method="get" data-slug-form>
          <span class="mono">https://</span>
          <input class="mono" name="slug" value="lunanails" aria-label="Your business name" maxlength="40" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="yourbusiness" data-slug-input />
          <span class="mono">.bookpage.app</span>
        </form>
        <p class="mk-slug-note mono" role="status" data-slug-note>Type a name to check it</p>
      </div>
    </div>
  </section>

  <Showcase templates={templates} signUp={links.signUp} />

  <!-- Who it's for -->
  <section id="stories" class="mk-fx mk-sec mk-stories" aria-labelledby="stories-title">
    <div class="mk-w mk-stack mk-stories-in">
      <div class="mk-stories-head" data-reveal>
        <div>
          <span class="mk-pilltag" style="--dot:#E9B949">Who it's for</span>
          <h2 id="stories-title" class="mk-h2">Stop <span class="scan">missing bookings</span></h2>
        </div>
        <span class="box mk-rating"><b>5 min</b><span class="mono">To go live · free, no card</span></span>
      </div>
      <div class="mk-cards" data-reveal>
        {stories.map((s) => {
          const d = dark(s.bg);
          const line = d ? '#FFFFFF' : '#0D0D10';
          return (
            <figure class:list={['mk-story', { 'mk-story-big': s.big }]} style={`flex-basis:${s.w}px;background:${s.bg};color:${s.fg};--rot:${s.rot}deg;--lift:${s.rot * 4}px`}>
              <span class="mk-story-top"><span class="mono">★ Built for</span><span class="mono mk-story-tag" style={`border-color:${line};background:${s.acc};color:${onAccent(s.acc)}`}>{s.tag}</span></span>
              <blockquote>“{s.q}”</blockquote>
              <span class="mono mk-story-stat" style={`border-color:${line};background:${d ? 'transparent' : '#FFFFFF'}`}>{s.stat}</span>
              <figcaption>
                <span class="mk-story-av" style={`border-color:${line};background:${s.acc};color:${onAccent(s.acc)}`} aria-hidden="true">{s.ini}</span>
                <span><b>{s.n}</b><small class="mono">{s.r}</small></span>
              </figcaption>
            </figure>
          );
        })}
      </div>
    </div>
    <div class="mk-mq" aria-label="Businesses BookPage is built for">
      {[rowA, rowB].map((row, r) => (
        <div class="mk-mq-row">
          <div class:list={['mk-mq-track', { 'mk-mq-rev': r === 1 }]}>
            {[...row, ...row].map(([n, k, c, ic], i) => (
              <span class="mk-biz" aria-hidden={i >= row.length || r === 1 ? 'true' : undefined}>
                <span class="mk-biz-ic" style={`background:${c};color:${c === '#E9B949' ? '#0D0D10' : '#FFFFFF'}`} aria-hidden="true">{ic}</span>
                <b>{n}</b><span class="mono">{k}</span>
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <Pricing from="/" />

  <!-- FAQ -->
  <section id="faq" class="mk-fx mk-sec mk-white mk-ruled" aria-labelledby="faq-title">
    <div class="mk-w mk-faq">
      <h2 id="faq-title" class="mk-h2" data-reveal>Questions, <span class="scan">answered</span></h2>
      <div class="mk-faq-list" data-reveal>
        {faqs.map(([q, a], i) => (
          <details class="mk-qa" name="faq" open={i === 0}>
            <summary>{q}<span class="mono" aria-hidden="true">+</span></summary>
            <p class="mono">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</MarketingLayout>

<script>
  // "Your own link": live availability check (the form still works without it).
  const input = document.querySelector<HTMLInputElement>('[data-slug-input]');
  const note = document.querySelector<HTMLElement>('[data-slug-note]');
  let timer: ReturnType<typeof setTimeout> | undefined;
  const check = () => {
    if (!input || !note) return;
    const slug = input.value.toLowerCase().replace(/[^a-z0-9-]/g, '');
    if (slug !== input.value) input.value = slug;
    clearTimeout(timer);
    if (!slug) {
      note.textContent = 'Type a name to check it';
      note.dataset.tone = '';
      return;
    }
    note.textContent = 'Checking…';
    timer = setTimeout(async () => {
      try {
        const r = (await (await fetch(`/check-slug?slug=${encodeURIComponent(slug)}`)).json()) as { available: boolean; valid: boolean };
        if (input.value !== slug) return;
        note.textContent = !r.valid ? 'Use 3–40 letters, numbers or single hyphens' : r.available ? `✓ ${slug}.bookpage.app is available` : `× ${slug}.bookpage.app is taken, try another`;
        note.dataset.tone = r.valid && r.available ? 'ok' : 'bad';
      } catch {
        note.textContent = 'Claim it when you sign up';
      }
    }, 350);
  };
  input?.addEventListener('input', check);
  check();
  document.querySelector('[data-slug-form]')?.addEventListener('submit', (e) => e.preventDefault());
</script>

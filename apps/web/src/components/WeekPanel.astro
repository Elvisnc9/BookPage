---
/**
 * This week at a glance (after the reference's black-and-yellow balance card):
 * bookings per day, Monday to Sunday, as bars on an ink panel, today in sun
 * yellow. Every number is real; nothing here is decorative data.
 */
interface Props {
  days: { label: string; count: number; isToday: boolean }[];
  weekCount: number;
  lastWeekCount: number;
}

const { days, weekCount, lastWeekCount } = Astro.props;
const max = Math.max(4, ...days.map((d) => d.count));
const diff = weekCount - lastWeekCount;
const diffLabel = diff === 0 ? 'Same as last week' : `${diff > 0 ? '+' : ''}${diff} vs last week`;
---

<section class="ap-week" aria-labelledby="week-title">
  <div class="ap-week-head">
    <div>
      <h2 id="week-title" class="ap-week-k mono">This week</h2>
      <p class="ap-week-v"><span class="ap-num">{weekCount}</span> {weekCount === 1 ? 'booking' : 'bookings'}</p>
    </div>
    <span class="ap-week-diff mono" data-up={diff > 0 || undefined}>{diffLabel}</span>
  </div>
  <ol class="ap-bars" aria-label="Bookings per day this week">
    {days.map((d) => (
      <li data-today={d.isToday || undefined} style={`--h:${(d.count / max) * 100}%`}>
        <span class="ap-bar-col"><span class="ap-bar-n">{d.count}</span><i aria-hidden="true"></i></span>
        <span class="ap-bar-d mono">{d.isToday ? 'Today' : d.label}</span>
      </li>
    ))}
  </ol>
</section>

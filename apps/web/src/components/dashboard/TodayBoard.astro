---
import { addDays, localDate, weekdayOf, WEEKDAY_SHORT, zonedToUtc } from '@bookpage/shared';
import AppIcon from '../AppIcon.astro';
import BookingRow from '../BookingRow.astro';
import WeekPanel from '../WeekPanel.astro';
import { getBilling } from '../../lib/billing';
import { getBookings, getSummary } from '../../lib/owner';
import ProNudge from './ProNudge.astro';
import { dayLabel, timeOf, whenLabel } from '../../lib/public';

/**
 * Today's data, streamed in as a server island: the page shell (navigation and a
 * skeleton) arrives at once, and this replaces the skeleton when the API answers.
 * Island requests have their own URL, so anything from the page's URL comes in as props.
 */
interface Props {
  /** The owner's first name, for the greeting. */
  first: string;
  /** The message after a booking action (post/redirect/get), if any. */
  message: { tone: 'ok' | 'bad'; text: string } | null;
}
const { first, message } = Astro.props;

const summary = await getSummary(Astro);
const tz = summary.timezone;
const dayStart = zonedToUtc(summary.today, 0, tz);
const dayEnd = zonedToUtc(addDays(summary.today, 1), 0, tz);
const monday = addDays(summary.today, 1 - weekdayOf(summary.today));
const lastMonday = addDays(monday, -7);

const [today, pending, fortnight, billing] = await Promise.all([
  getBookings(Astro, { from: dayStart, to: dayEnd, status: ['pending', 'confirmed', 'completed', 'no_show'] }),
  getBookings(Astro, { from: new Date(), status: ['pending'] }),
  getBookings(Astro, { from: zonedToUtc(lastMonday, 0, tz), to: zonedToUtc(addDays(monday, 7), 0, tz), status: ['pending', 'confirmed', 'completed', 'no_show'] }),
  // The plan only decides whether to mention Pro; the board works without it.
  getBilling(Astro).catch(() => null),
]);

// Bookings per day, Monday to Sunday, in the business's time zone.
const perDay = new Map<string, number>();
for (const b of fortnight) {
  const { date } = localDate(new Date(b.startsAt), tz);
  perDay.set(date, (perDay.get(date) ?? 0) + 1);
}
const days = WEEKDAY_SHORT.map((label, i) => {
  const date = addDays(monday, i);
  return { label, count: perDay.get(date) ?? 0, isToday: date === summary.today };
});
const lastWeekCount = Array.from({ length: 7 }, (_, i) => perDay.get(addDays(lastMonday, i)) ?? 0).reduce((a, b) => a + b, 0);

const pendingLater = pending.filter((b) => new Date(b.startsAt) >= dayEnd);
const n = summary.todayCount;
const hour = Number(new Intl.DateTimeFormat('en-US', { hour: 'numeric', hourCycle: 'h23', timeZone: tz }).format(new Date()));
const greeting = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';

// A milestone worth marking, and only then a word about Pro (free plan only).
const kept = fortnight.filter((b) => b.status !== 'no_show').length;
const milestone = billing?.effectivePlan === 'free' && kept >= 10 ? kept : null;
---

<div class="ap-island">
  <p class="ap-date mono"><i aria-hidden="true"></i>{dayLabel(summary.today).long}</p>
  <div class="ap-head">
    <div>
      <p class="ap-greet">{greeting}{first ? `, ${first}` : ''}.</p>
      <h1 class="ap-h1">{n === 0 ? 'Nothing booked today' : `${n} booking${n === 1 ? '' : 's'} today`}</h1>
    </div>
    <a class="btn btn-primary" href="/bookings">All bookings <AppIcon name="arrow" size={16} /></a>
  </div>

  {message && <p class={`ap-flash ${message.tone}`} role="status">{message.text}</p>}
  {milestone && (
    <ProNudge id="milestone-10" title={`${milestone} bookings this week and last. Nice.`} href="/billing" cta="See what Pro adds"
      text="Ready to look the part? Pro gives you your own domain for a year, the Pro templates, and takes the BookPage badge off your page." />
  )}

  <div class="ap-hero">
    <div class="ap-stats">
      <div class="ap-stat">
        <span class="ap-stat-k"><span class="ap-stat-ic" aria-hidden="true"><AppIcon name="today" size={18} /></span>Today</span>
        <strong class="ap-num ap-stat-v">{summary.todayCount}</strong>
        <span class="ap-stat-sub">{summary.weekCount} this week</span>
      </div>
      <a class={`ap-stat ap-stat-link${summary.pendingCount ? ' is-alert' : ''}`} href="/bookings?view=pending">
        <span class="ap-stat-k"><span class="ap-stat-ic" aria-hidden="true"><AppIcon name="bell" size={18} /></span>Needs your OK</span>
        <strong class="ap-num ap-stat-v">{summary.pendingCount}</strong>
        <span class="ap-stat-sub ap-stat-go">{summary.pendingCount ? 'Review' : 'All clear'} <AppIcon name="arrow" size={14} /></span>
      </a>
      <div class="ap-stat ap-stat-next">
        <span class="ap-stat-k"><span class="ap-stat-ic" aria-hidden="true"><AppIcon name="clock" size={18} /></span>Next up</span>
        {summary.next ? (
          <>
            <strong class="ap-num ap-stat-v">{timeOf(summary.next.startsAt, tz)}</strong>
            <span class="ap-stat-sub">{summary.next.customer.name} · {summary.next.serviceName}{new Date(summary.next.startsAt) >= dayEnd ? ` · ${whenLabel(summary.next.startsAt, tz).split(',')[0]}` : ''}</span>
          </>
        ) : (
          <span class="ap-stat-sub">Nothing coming up yet.</span>
        )}
      </div>
    </div>

    <WeekPanel days={days} weekCount={summary.weekCount} lastWeekCount={lastWeekCount} />
  </div>

  <section class="ap-panel ap-table" aria-labelledby="sched">
    <div class="ap-table-head">
      <h2 id="sched" class="ap-h2">Today's schedule</h2>
      <span class="pill" data-tone="info">{today.length} {today.length === 1 ? 'booking' : 'bookings'}</span>
    </div>
    {today.length ? (
      <div class="ap-rows">
        <div class="ap-cols mono" aria-hidden="true"><span>Customer</span><span>Service</span><span>Time</span><span>Status</span><span>Price</span><span></span></div>
        {today.map((b) => <BookingRow booking={b} timezone={tz} />)}
      </div>
    ) : (
      <p class="ap-empty">No bookings today. <a href="/share">Share your page link</a> to fill your diary.</p>
    )}
  </section>

  {pendingLater.length > 0 && (
    <section class="ap-panel ap-table" aria-labelledby="later">
      <div class="ap-table-head">
        <h2 id="later" class="ap-h2">Waiting for your OK</h2>
        <span class="pill" data-tone="wait">{pendingLater.length}</span>
      </div>
      <div class="ap-rows">
        <div class="ap-cols mono" aria-hidden="true"><span>Customer</span><span>Service</span><span>When</span><span>Status</span><span>Price</span><span></span></div>
        {pendingLater.map((b) => <BookingRow booking={b} timezone={tz} showDate />)}
      </div>
    </section>
  )}
</div>

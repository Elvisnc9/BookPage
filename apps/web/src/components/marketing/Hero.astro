---
import { siteLinks } from '../../lib/marketing';

/**
 * Home hero. One composed scene instead of scattered stickers: the customer's
 * booking page on a phone, the booking it just created arriving for the owner,
 * the confirmation email, and the owner's Today card behind. Every piece is a
 * real BookPage screen in miniature. Motion lives in scripts/hero.ts.
 *
 * data-depth (0–1.5) sets how far each piece moves with the pointer and how
 * late it enters; data-intro marks what the entrance timeline reveals.
 */
const links = siteLinks(Astro.url);
const slots = ['9:00', '9:30', '10:00', '10:30', '11:00', '11:30'];
const days = [['THU', '15'], ['FRI', '16'], ['SAT', '17'], ['SUN', '18']];
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="mk-w hero-in">
    <div class="hero-copy">
      <span class="hero-kicker mono" data-intro>Free booking pages for local businesses</span>
      <h1 id="hero-title" class="hero-title">
        <span class="hero-line"><span data-intro>Never miss</span></span>
        <span class="hero-line"><span data-intro>a <span class="scan">booking.</span></span></span>
      </h1>
      <p class="hero-lede" data-intro>
        One link with your services, prices and real free times. Customers book in under a minute and get a confirmation and a reminder. You get every booking straight to your inbox.
      </p>
      <div class="hero-actions" data-intro>
        <a class="btn btn-primary hero-btn" href={links.signUp}>Create my free page</a>
        <a class="btn hero-btn" href={links.example}>See an example ↗</a>
      </div>
      <ul class="hero-facts mono" data-intro>
        <li>Free</li>
        <li>No card</li>
        <li>Ready in about 5 minutes</li>
      </ul>
    </div>

    <div class="hero-stage" role="img" aria-label="A customer picks Saturday 10:30 on a BookPage booking page; the booking arrives for the owner, a confirmation email goes out, and it lands on the owner's Today screen." data-stage>
      <span class="hs hs-sun" data-depth="0.25" data-intro aria-hidden="true"></span>
      <span class="hs hs-dots" data-depth="0.12" data-intro aria-hidden="true"></span>
      <span class="hs hs-block" data-depth="0.4" data-intro aria-hidden="true"></span>
      <svg class="hs hs-spark" data-depth="0.9" data-intro viewBox="0 0 40 40" aria-hidden="true"><path d="M20 2v36M2 20h36M7 7l26 26M33 7L7 33" stroke="#0D0D10" stroke-width="4" stroke-linecap="round" /></svg>

      <!-- Behind: the owner's Today card -->
      <div class="ha ha-today" data-depth="0.45" data-intro aria-hidden="true">
        <span class="ha-today-k mono">Today</span>
        <svg viewBox="0 0 200 60" preserveAspectRatio="none"><polyline points="0,50 30,42 60,46 90,22 120,30 150,12 200,18" /></svg>
        <span class="ha-today-card">
          <small>Bookings today</small>
          <strong>3</strong>
        </span>
      </div>

      <!-- Centre: the booking page on a phone -->
      <div class="ha ha-phone" data-depth="0.8" data-intro aria-hidden="true">
        <span class="ha-notch"></span>
        <span class="ha-biz">
          <span class="ha-logo mono">GS</span>
          <span><b>Glow Studio</b><small class="mono">Salon · Brooklyn</small></span>
        </span>
        <span class="ha-svc"><b>Silk press</b><span class="mono">1 h 30 · $85</span></span>
        <span class="ha-label mono">Pick a time</span>
        <span class="ha-days">
          {days.map(([d, n]) => <span data-on={n === '17' || undefined}><small class="mono">{d}</small>{n}</span>)}
        </span>
        <span class="ha-slots">
          {slots.map((t) => <span class="mono" data-slot={t} data-on={t === '10:30' || undefined}>{t}</span>)}
        </span>
        <span class="ha-cta mono" data-cta>Confirm booking</span>
      </div>

      <!-- Front: what happens next -->
      <div class="ha ha-toast" data-depth="1.25" data-intro data-toast aria-hidden="true">
        <span class="ha-tick">✓</span>
        <span>
          <small class="mono">New booking · now</small>
          <b>Dana W. booked Silk press</b>
          <small class="mono">Sat 17 Oct · 10:30 · with Maya</small>
        </span>
      </div>
      <div class="ha ha-mail" data-depth="1.05" data-intro data-mail aria-hidden="true">
        <span class="ha-env" aria-hidden="true"></span>
        <span><b>You're booked</b><small class="mono">Reminder Fri 10:30</small></span>
      </div>
      <span class="ha ha-pin mono" data-depth="1.45" data-intro aria-hidden="true">Sat 10:30</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: var(--border);
    background-color: var(--page);
    background-image: radial-gradient(#C9C8C1 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .hero-in { display: grid; gap: 48px; padding-top: 40px; padding-bottom: 56px; }

  /* Copy */
  .hero-copy { position: relative; z-index: 2; display: grid; gap: 24px; align-content: start; }
  .hero-kicker {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border: var(--border);
    border-radius: var(--r-pill);
    background: var(--surface);
    box-shadow: 2px 2px 0 var(--ink);
    font-size: 11px;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .hero-kicker::before { content: ''; width: 8px; height: 8px; border-radius: 2px; background: var(--sun-deep); outline: 1.5px solid var(--ink); }
  .hero-title { margin: 0; font-size: clamp(54px, 15vw, 150px); font-weight: 900; letter-spacing: -0.065em; line-height: .86; }
  .hero-line { display: block; overflow: hidden; padding-bottom: .06em; }
  .hero-line > span { display: inline-block; white-space: nowrap; }
  .hero-lede { margin: 0; max-width: 44ch; font-size: clamp(17px, 1.5vw, 20px); line-height: 1.5; font-weight: 500; color: var(--ink-soft); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }
  .hero-btn { min-height: 54px; padding: 0 22px; font-size: 13px; }
  .hero-facts { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 0; padding: 0; list-style: none; font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
  .hero-facts li { display: inline-flex; align-items: center; gap: 8px; }
  .hero-facts li::before { content: '✓'; display: grid; place-items: center; width: 16px; height: 16px; border: 1.5px solid var(--ink); border-radius: 4px; background: var(--tint-mint); color: var(--ink); font-size: 10px; font-weight: 800; }

  /* Stage: a fixed 560×560 composition, scaled to fit. data-depth drives entrance order and pointer parallax (scripts/hero.ts). */
  .hero-stage {
    --stage: 560px;
    position: relative;
    z-index: 1;
    width: min(100%, var(--stage));
    aspect-ratio: 1;
    margin: 0 auto;
    container-type: inline-size;
  }
  .hs, .ha { position: absolute; }

  /* Geometry behind everything */
  .hs-sun { left: 30%; top: 4%; width: 62cqi; aspect-ratio: 1; border: var(--border); border-radius: 50%; background: var(--sun); }
  .hs-dots { right: 0; bottom: 6%; width: 34cqi; aspect-ratio: 1; border: 1.5px dashed var(--ink); border-radius: var(--r-xl); background-image: radial-gradient(var(--ink) 1.5px, transparent 1.5px); background-size: 14px 14px; opacity: .55; }
  .hs-block { left: 2%; bottom: 10%; width: 22cqi; aspect-ratio: 1; border: var(--border); border-radius: var(--r-lg); background: var(--periwinkle); rotate: -8deg; box-shadow: var(--shadow-press); }
  .hs-spark { right: 6%; top: 8%; width: 7cqi; height: auto; }

  /* Owner's Today card (behind, left) */
  .ha-today {
    left: 0;
    top: 12%;
    width: 44cqi;
    padding: 3cqi;
    border: var(--border);
    border-radius: var(--r-xl);
    background: repeating-linear-gradient(90deg, transparent 0 18px, rgba(255, 255, 255, .1) 18px 36px), var(--periwinkle);
    box-shadow: var(--shadow-sm);
    rotate: -6deg;
    display: grid;
    gap: 2cqi;
  }
  .ha-today-k { color: var(--surface); font-size: clamp(9px, 2cqi, 12px); text-transform: uppercase; letter-spacing: .08em; }
  .ha-today svg { width: 100%; height: 11cqi; }
  .ha-today polyline { fill: none; stroke: var(--surface); stroke-width: 3; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .ha-today-card { display: grid; padding: 2.4cqi 3cqi; border: var(--border); border-radius: var(--r-lg); background: var(--peach); box-shadow: 0 5px 0 -1px var(--tint-orange), 0 5px 0 1px var(--ink); }
  .ha-today-card small { font-size: clamp(9px, 2.2cqi, 13px); font-weight: 600; }
  .ha-today-card strong { font-size: clamp(22px, 8cqi, 44px); font-weight: 900; line-height: 1; letter-spacing: -0.04em; }

  /* The phone */
  .ha-phone {
    left: 32%;
    top: 10%;
    width: 44cqi;
    padding: 4cqi 3.4cqi 3.4cqi;
    display: grid;
    gap: 2.4cqi;
    border: var(--border);
    border-radius: 6cqi;
    background: var(--surface);
    box-shadow: var(--shadow);
    rotate: 3deg;
    font-size: clamp(9px, 2.5cqi, 14px);
  }
  .ha-notch { justify-self: center; width: 30%; height: 1.6cqi; border-radius: var(--r-pill); background: var(--ink); margin-bottom: 1cqi; }
  .ha-biz { display: flex; align-items: center; gap: 2cqi; }
  .ha-biz b { display: block; font-size: 1.15em; font-weight: 800; letter-spacing: -0.02em; }
  .ha-biz small { font-size: .78em; color: var(--muted); }
  .ha-logo { display: grid; place-items: center; flex: none; width: 8cqi; height: 8cqi; border: var(--border); border-radius: var(--r); background: var(--sun); font-size: .8em; font-weight: 800; }
  .ha-svc { display: flex; justify-content: space-between; gap: 2cqi; padding: 2cqi 2.4cqi; border: 1.5px solid var(--ink); border-radius: var(--r); background: var(--tint-sun); }
  .ha-svc .mono { font-size: .78em; }
  .ha-label { font-size: .72em; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .ha-days { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.4cqi; }
  .ha-days > span { display: grid; justify-items: center; padding: 1.4cqi 0; border: 1.5px solid var(--line); border-radius: var(--r); font-weight: 800; }
  .ha-days small { font-size: .62em; font-weight: 500; color: var(--muted); }
  .ha-days [data-on] { border: var(--border); background: var(--peach); }
  .ha-slots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4cqi; }
  .ha-slots > span { display: grid; place-items: center; padding: 1.6cqi 0; border: 1.5px solid var(--ink); border-radius: var(--r); font-size: .82em; font-weight: 600; transition: background-color 200ms ease, box-shadow 200ms ease; }
  .ha-slots [data-on] { background: var(--sun); box-shadow: 2px 2px 0 var(--ink); }
  .ha-cta { display: grid; place-items: center; padding: 2.2cqi 0; border-radius: var(--r); background: var(--ink); color: var(--surface); font-size: .8em; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; box-shadow: 2px 2px 0 var(--sun-deep); }

  /* Front: the booking arriving, the email, a time tag */
  .ha-toast {
    right: 0;
    top: 46%;
    width: 52cqi;
    display: flex;
    gap: 2.4cqi;
    padding: 2.6cqi 3cqi;
    border: var(--border);
    border-radius: var(--r-xl);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    rotate: -2deg;
    font-size: clamp(9px, 2.4cqi, 14px);
  }
  .ha-toast > span:last-child { display: grid; gap: .3em; min-width: 0; }
  .ha-toast b { font-weight: 800; }
  .ha-toast small { font-size: .78em; color: var(--muted); }
  .ha-tick { display: grid; place-items: center; flex: none; width: 8cqi; height: 8cqi; border: var(--border); border-radius: var(--r); background: var(--mint); font-weight: 900; }

  .ha-mail {
    left: 8%;
    bottom: 4%;
    display: flex;
    align-items: center;
    gap: 2.4cqi;
    padding: 2.4cqi 3.4cqi 2.4cqi 2.4cqi;
    border: var(--border);
    border-radius: var(--r-xl);
    background: var(--tint-sun);
    box-shadow: var(--shadow-press);
    rotate: 4deg;
    font-size: clamp(9px, 2.4cqi, 14px);
  }
  .ha-mail > span:last-child { display: grid; }
  .ha-mail b { font-weight: 800; }
  .ha-mail small { font-size: .78em; color: var(--muted); }
  .ha-env {
    position: relative;
    flex: none;
    width: 9cqi;
    height: 6.6cqi;
    border: var(--border);
    border-radius: 3px;
    background: var(--surface);
    overflow: hidden;
  }
  .ha-env::after { content: ''; position: absolute; left: 50%; top: -55%; width: 70%; aspect-ratio: 1; border: var(--border); background: var(--peach); translate: -50% 0; rotate: 45deg; }

  .ha-pin {
    right: 12%;
    top: 30%;
    padding: 1.4cqi 2.6cqi;
    border: var(--border);
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--surface);
    font-size: clamp(9px, 2.2cqi, 13px);
    box-shadow: 2px 2px 0 var(--sun-deep);
    rotate: 6deg;
  }

  /* Before the entrance runs (motion allowed, JS loaded), keep the pieces hidden. */
  :global(html.hero-motion) [data-hero] [data-intro] { opacity: 0; }

  @media (min-width: 960px) {
    .hero-in { grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); align-items: center; gap: 40px; padding-top: 64px; padding-bottom: 72px; min-height: min(760px, calc(100svh - 64px)); }
    .hero-title { font-size: clamp(72px, 8vw, 128px); }
  }

  /* Tablets (portrait): the hero is the screen. Headline across the top, then
     the words beside the scene, so nothing waits below the fold. The copy's
     children join the hero grid directly. */
  @media (min-width: 600px) and (max-width: 959px) {
    .hero-in {
      grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
      grid-template-areas: 'kick kick' 'title title' 'lede stage' 'acts stage' 'facts stage';
      align-content: center;
      gap: 20px 28px;
      min-height: calc(100svh - 72px);
      padding-top: 24px;
      padding-bottom: 32px;
    }
    .hero-copy { display: contents; }
    .hero-kicker { grid-area: kick; }
    .hero-title { grid-area: title; font-size: clamp(72px, 12.5vw, 112px); }
    .hero-lede { grid-area: lede; font-size: 16px; }
    .hero-actions { grid-area: acts; flex-direction: column; align-items: stretch; }
    .hero-facts { grid-area: facts; flex-direction: column; align-self: start; }
    .hero-stage { grid-area: stage; align-self: center; }
  }

  @media (max-width: 520px) {
    .hs-dots, .hs-spark, .ha-pin { display: none; }
    .hero-in { gap: 32px; padding-bottom: 40px; }
  }
</style>

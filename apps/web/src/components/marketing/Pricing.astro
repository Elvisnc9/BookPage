---
import { siteLinks } from '../../lib/marketing';

/** Free and Pro ($15/mo, waitlist only for now), plus what's coming. Used on the home page and /pricing. */
interface Props {
  /** Where the waitlist form returns to. */
  from: string;
  headingLevel?: 'h1' | 'h2';
}

const { from, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const links = siteLinks(Astro.url);
const joined = Astro.url.searchParams.has('joined');
const error = Astro.url.searchParams.get('waitlist_error');

const free = [
  'Your own booking page and link',
  'Unlimited bookings',
  'Services, prices, hours and team',
  'No double bookings, ever',
  'Email confirmations and day-before reminders',
  'An email for every new booking',
  'Approve requests or auto-confirm',
];
const pro = [
  'Everything in Free',
  'More templates, your colours and logo',
  'A short video of your space',
  'A gallery of your best work',
  'Remove the BookPage badge',
  'Priority support',
];
const later = [
  'AI receptionist that answers customer questions',
  'Google Calendar sync',
  'WhatsApp reminders',
  'Your own domain',
  'Deposits and online payments',
];
---

<section id="pricing" class="mk-fx mk-sec mk-white mk-ruled-top" aria-labelledby="pricing-title">
  <div class="mk-w mk-stack mk-pricing">
    <div class="mk-head mk-head-center" data-reveal>
      <Heading id="pricing-title" class="mk-h2">Start free. <span class="scan">Grow with Pro.</span></Heading>
      <p class="mk-sub mono">Taking bookings is free, for good. Upgrade when you want your page to look and feel like your brand.</p>
    </div>

    <div class="mk-plans" data-reveal>
      <article class="box mk-plan">
        <span class="mk-badge mono" style="background:#FCE9DC">Free</span>
        <p class="mk-price"><strong>$0</strong><span class="mono">forever</span></p>
        <p>Everything you need to start taking bookings.</p>
        <a class="btn mk-plan-btn" href={links.signUp}>Create my free page</a>
        <ul class="mk-plus-list mono">{free.map((x) => <li>+ {x}</li>)}</ul>
      </article>

      <article id="pro" class="box mk-plan mk-plan-pro">
        <span class="mk-flag mono">Opening soon</span>
        <span class="mk-badge mono" style="background:#E9B949">Pro</span>
        <p class="mk-price"><strong>$15</strong><span class="mono">/month</span></p>
        <p>Your page, your brand, your best work on show.</p>
        {joined ? (
          <p class="mk-joined mono" role="status">✓ You're on the list. We'll email you once, when Pro opens.</p>
        ) : (
          <form class="mk-waitlist" method="post" action="/waitlist">
            <input type="hidden" name="from" value={from} />
            <label class="lab" for="waitlist-email">Get told when it opens</label>
            <div class="mk-waitlist-row">
              <input id="waitlist-email" class="mono" type="email" name="email" required maxlength="120" autocomplete="email" placeholder="you@business.com"
                aria-invalid={error ? 'true' : undefined} aria-describedby={error ? 'waitlist-error' : undefined} />
              <button class="btn" type="submit">Join the waitlist</button>
            </div>
            {error && <p id="waitlist-error" class="mk-error mono" role="alert">{error}</p>}
            <div class="mk-honey" aria-hidden="true"><label>Company <input name="company" tabindex="-1" autocomplete="off" /></label></div>
          </form>
        )}
        <ul class="mk-plus-list mono">{pro.map((x) => <li>+ {x}</li>)}</ul>
      </article>

      <article class="box mk-plan mk-plan-later">
        <span class="mk-badge mono" style="background:#C8553D;color:#FFFFFF">Coming soon</span>
        <p class="mk-plan-title">What we're building next.</p>
        <ul class="mk-plus-list mono">{later.map((x) => <li>○ {x}</li>)}</ul>
        <p class="mk-plan-note mono">Join the Pro waitlist and we will tell you when each one is ready.</p>
        <a class="btn mk-plan-btn-sm" href="#pro">Join the waitlist</a>
      </article>
    </div>
  </div>
</section>

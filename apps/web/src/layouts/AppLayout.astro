---
import { ROOT_DOMAIN } from 'astro:env/server';
import { localDate } from '@bookpage/shared';
import AppIcon from '../components/AppIcon.astro';
import ClerkScript from '../components/ClerkScript.astro';
import Base from './Base.astro';
import '../styles/app.css';
import { dayLabel, initials } from '../lib/public';

interface Props {
  title: string;
  active: 'today' | 'bookings' | 'page' | 'share' | 'billing';
  /** The business time zone, for the date line. */
  timezone?: string | undefined;
  /** Optional heading shown in the page header (the page's own h1 otherwise). */
  heading?: string | undefined;
}

const { title, active, timezone } = Astro.props;
const { user, business } = Astro.locals.me!;
const { protocol, port } = Astro.url;
const pageHost = business ? `${business.slug}.${ROOT_DOMAIN}${port ? `:${port}` : ''}` : '';
const pageUrl = `${protocol}//${pageHost}`;
const today = timezone ? dayLabel(localDate(new Date(), timezone).date) : null;
const who = user.name ?? user.email;

const nav = [
  { key: 'today', label: 'Today', href: '/', icon: 'today' },
  { key: 'bookings', label: 'Bookings', href: '/bookings', icon: 'bookings' },
  { key: 'page', label: 'My page', href: '/page', icon: 'page' },
  { key: 'share', label: 'Share', href: '/share', icon: 'share' },
  { key: 'billing', label: 'Plan', href: '/billing', icon: 'star' },
] as const;
---

<Base title={`${title} · BookPage`}>
  <div class="ap">
    <!-- Rail on tablets, full sidebar on desktops (hidden on phones: top bar + bottom tabs). -->
    <aside class="ap-side" aria-label="Dashboard">
      <a class="ap-brand mono" href="/" aria-label="BookPage, Today">
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="9" height="9" rx="2" fill="#0D0D10" /><rect x="13" y="13" width="9" height="9" rx="2" fill="#0D0D10" /><rect x="13" y="2" width="9" height="9" rx="2" fill="#F7D45C" stroke="#0D0D10" stroke-width="1.6" /></svg>
        <span class="ap-wide">BookPage</span>
      </a>

      <nav class="ap-nav" aria-label="Dashboard sections">
        <p class="ap-nav-k lab ap-wide">Menu</p>
        {nav.map((n) => (
          <a class="ap-nav-link" href={n.href} aria-current={n.key === active ? 'page' : undefined}>
            <AppIcon name={n.icon} />
            <span>{n.label}</span>
          </a>
        ))}
        <a class="ap-nav-link" href={pageUrl} target="_blank" rel="noopener">
          <AppIcon name="external" />
          <span><span class="ap-wide">View my </span><span class="ap-rail-only">View </span>page</span>
        </a>
      </nav>

      <section class="ap-share ap-wide" aria-labelledby="share-title">
        <p id="share-title" class="ap-share-k"><span class="lab">Your page</span><span class="ap-share-live mono"><i aria-hidden="true"></i>Live</span></p>
        <a class="ap-share-url mono" href={pageUrl} target="_blank" rel="noopener">{pageHost}</a>
        <button type="button" class="btn btn-primary ap-copy" data-copy={pageUrl}>
          <AppIcon name="copy" size={16} /> <span data-copy-label>Copy link</span>
        </button>
        <a class="ap-share-more" href="/share"><AppIcon name="qr" size={16} /> QR code and messages</a>
      </section>

      <div class="ap-me">
        <span class="avatar ap-avatar" data-hue="1" aria-hidden="true">{initials(who)}</span>
        <span class="ap-me-text ap-wide">
          <strong>{who}</strong>
          <span class="mono">{business?.name}</span>
        </span>
        <button class="ap-out" type="button" data-sign-out aria-label="Sign out" title="Sign out"><AppIcon name="logout" /></button>
      </div>
    </aside>

    <header class="ap-bar">
      <a class="ap-brand mono" href="/">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="9" height="9" rx="2" fill="#0D0D10" /><rect x="13" y="13" width="9" height="9" rx="2" fill="#0D0D10" /><rect x="13" y="2" width="9" height="9" rx="2" fill="#F7D45C" stroke="#0D0D10" stroke-width="1.6" /></svg>
        BookPage
      </a>
      <a class="pill ap-bar-live" data-tone="ok" href={pageUrl} target="_blank" rel="noopener"><i aria-hidden="true"></i>Page live</a>
      <button class="icon-btn ap-bar-out" type="button" data-sign-out aria-label="Sign out"><AppIcon name="logout" /></button>
    </header>

    <main class="ap-main" id="main">
      {today && (
        <p class="ap-date mono"><i aria-hidden="true"></i>{today.long}</p>
      )}
      <slot />
    </main>

    <nav class="ap-tabs-bottom" aria-label="Dashboard sections">
      {nav.map((n) => (
        <a href={n.href} aria-current={n.key === active ? 'page' : undefined}>
          <AppIcon name={n.icon} size={22} />
          <span>{n.label}</span>
        </a>
      ))}
    </nav>
  </div>

  <div class="ap-progress" aria-hidden="true"></div>
  <ClerkScript />
  <script>
    // Start the progress bar the moment the owner navigates (links and form posts),
    // so a click is acknowledged before the next page arrives.
    const navigating = () => document.documentElement.classList.add('is-navigating');
    document.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const a = (e.target as Element).closest('a[href]') as HTMLAnchorElement | null;
      if (!a || a.target === '_blank' || a.hasAttribute('download') || a.origin !== location.origin) return;
      if (a.pathname === location.pathname && a.search === location.search && a.hash) return; // same-page anchor
      navigating();
    });
    document.addEventListener('submit', (e) => { if (!e.defaultPrevented) navigating(); });
    // Coming back with the Back button restores the old page from cache: clear the bar.
    addEventListener('pageshow', () => document.documentElement.classList.remove('is-navigating'));
  </script>
  <script>
    // Sign out through Clerk (it clears its own cookies), then back to sign-in.
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-sign-out]')) {
      button.addEventListener('click', () => {
        button.disabled = true;
        const clerk = (window as { Clerk?: { signOut: (o: { redirectUrl: string }) => Promise<unknown> } }).Clerk;
        if (clerk) void clerk.signOut({ redirectUrl: '/sign-in' });
        else location.href = '/sign-in';
      });
    }

    // Copy buttons (page link, share messages). The label says what happened, then resets.
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      const label = button.querySelector<HTMLElement>('[data-copy-label]');
      const original = label?.textContent ?? '';
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy!);
          if (label) label.textContent = 'Copied';
        } catch {
          if (label) label.textContent = 'Copy failed';
        }
        setTimeout(() => { if (label) label.textContent = original; }, 2000);
      });
    }
  </script>
</Base>

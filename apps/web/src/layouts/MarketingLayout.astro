---
import Base from './Base.astro';
import '../styles/marketing.css';
import { siteLinks } from '../lib/marketing';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const links = siteLinks(Astro.url);
// Set by the owner app when someone is signed in (a display hint only; the dashboard checks the real session).
const owner = decodeURIComponent(Astro.cookies.get('bp_owner')?.value ?? '').trim().slice(0, 30) || null;
const onHome = Astro.url.pathname === '/';
const anchor = (id: string) => (onHome ? `#${id}` : `/#${id}`);
---

<Base title={title} description={description}>
  <script is:inline slot="head">
    // Hide the hero's pieces until its entrance runs (avoids a flash of the final state).
    // Wide screens only: phones show the hero at once (no waiting on JavaScript).
    // Never hidden with reduced motion, and shown anyway if the motion script doesn't arrive.
    if (matchMedia('(min-width: 960px) and (prefers-reduced-motion: no-preference)').matches) {
      document.documentElement.classList.add('hero-motion');
      setTimeout(function () { document.documentElement.classList.remove('hero-motion'); }, 2500);
    }
  </script>
  <div class="mk-page">
    <a class="mk-skip" href="#main">Skip to content</a>
    <header class="mk-w mk-header">
      <a class="mk-logo" href="/" aria-label="BookPage home">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="9" height="9" rx="2" fill="#0D0D10" /><rect x="13" y="13" width="9" height="9" rx="2" fill="#0D0D10" /><rect x="13" y="2" width="9" height="9" rx="2" fill="none" stroke="#0D0D10" stroke-width="1.6" /></svg>
        <span class="mono">BOOKPAGE</span>
      </a>
      <nav class="mk-nav" aria-label="Main">
        <a href={anchor('how')}>How it works</a>
        <a href={anchor('templates')}>Templates</a>
        <a href={anchor('stories')}>Who it's for</a>
        <a href={onHome ? '#pricing' : '/pricing'}>Pricing</a>
        <a href={anchor('faq')}>FAQ</a>
      </nav>
      {owner ? (
        <a class="btn btn-ink mk-cta mk-owner" href={links.dashboard} aria-label={`Open your dashboard, ${owner}`}>
          <span class="mk-owner-dot" aria-hidden="true">{owner.slice(0, 1).toUpperCase()}</span>{owner} <span aria-hidden="true">→</span>
        </a>
      ) : (
        <>
          <a class="mk-signin" href={links.signIn}>Sign in</a>
          <a class="btn btn-ink mk-cta" href={links.signUp}>Create my page</a>
        </>
      )}
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mk-footer">
      <div class="mk-w mk-footer-in">
        <div class="mk-footer-top">
          <div class="mk-footer-cta">
            <p class="mk-footer-line">Your business, <span class="scan">on autopilot</span></p>
            <a class="mk-footer-claim" href={links.signUp}>
              <span class="mono">yourbusiness.{links.rootDomain}</span>
              <span class="btn btn-ink">Create my page</span>
            </a>
            <span class="mono mk-footer-note">Free forever for taking bookings. No card needed.</span>
          </div>
          <nav class="mk-footer-nav" aria-label="Footer">
            <div>
              <span class="lab">Product</span>
              <a href={anchor('how')}>How it works</a>
              <a href={links.example}>Example page</a>
              <a href="/pricing">Pricing</a>
              <a href={anchor('faq')}>FAQ</a>
            </div>
            <div>
              <span class="lab">Account</span>
              <a href={links.signUp}>Create my page</a>
              <a href={links.signIn}>Sign in</a>
            </div>
            <div>
              <span class="lab">Legal</span>
              <a href="/privacy">Privacy</a>
              <a href="/terms">Terms</a>
            </div>
          </nav>
        </div>
        <p class="mk-wordmark scan" aria-hidden="true">BOOKPAGE</p>
        <div class="mk-footer-bottom mono">
          <span class="mk-live"><i class="blink"></i>Bookings open 24/7</span>
          <span class="mk-footer-legal"><a href="/privacy">Privacy</a><a href="/terms">Terms</a></span>
          <span>© 2026 BookPage</span>
          <a href="#main">Back to top ↑</a>
        </div>
      </div>
    </footer>
  </div>

  <script>
    // Motion is an enhancement: only load it when the visitor hasn't asked for less.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      void import('../scripts/motion');
    }
  </script>
</Base>

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bookpage-web",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Dev uses the astro:env defaults (localhost). Production is selected with CLOUDFLARE_ENV=production.
  "env": {
    "production": {
      // One Worker serves every host: marketing (apex, www), the owner app (app.) and every
      // booking page ({slug}.). The zone must be on Cloudflare with proxied DNS records for
      // the apex, www, app and a wildcard (*). See docs/DEPLOY.md.
      "routes": [
        { "pattern": "bookpage.app/*", "zone_name": "bookpage.app" },
        { "pattern": "*.bookpage.app/*", "zone_name": "bookpage.app" }
      ],
      "vars": {
        "ROOT_DOMAIN": "bookpage.app",
        "APP_HOST": "app.bookpage.app",
        // The API's own address. If you give it api.bookpage.app, make that DNS record
        // DNS-only (grey cloud) so the wildcard route above doesn't catch it.
        "API_URL": "https://api.bookpage.app"
      }
      // Secret, set once: wrangler secret put PROXY_SECRET --env production
    }
  }
}

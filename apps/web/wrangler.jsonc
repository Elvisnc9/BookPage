{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bookpage-web",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Dev uses the astro:env defaults (localhost). Production is selected with CLOUDFLARE_ENV=production.
  "env": {
    "production": {
      // YOUR DOMAIN: replace bookpage.app below (5 places) with your domain, e.g.
      // bookpage.dpdns.org. One Worker serves every host: marketing (apex, www), the owner app (app.) and every
      // booking page ({slug}.). The zone must be on Cloudflare with proxied DNS records for
      // the apex, www, app and a wildcard (*). See docs/DEPLOY.md.
      "routes": [
        { "pattern": "bookpage.app/*", "zone_name": "bookpage.app" },
        { "pattern": "*.bookpage.app/*", "zone_name": "bookpage.app" }
      ],
      "vars": {
        "ROOT_DOMAIN": "bookpage.app",
        "APP_HOST": "app.bookpage.app",
        // The API's address on Render (free plan: no custom domain needed). Use the exact
        // URL Render shows for the service; it adds a suffix if the name is taken.
        "API_URL": "https://bookpage-api.onrender.com"
      }
      // Secret, set once: wrangler secret put PROXY_SECRET --env production
    }
  }
}

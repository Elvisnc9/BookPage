# Root domain the booking pages hang off. "localhost" in dev, "bookpage.app" in prod.
ROOT_DOMAIN=localhost
# Owner app host. "localhost" in dev (Google OAuth needs it), "app.bookpage.app" in prod.
APP_HOST=localhost
API_URL=http://localhost:3000
# Shared secret sent with the visitor's IP so the API's rate limits key on the visitor.
# Same value as PROXY_SECRET in apps/api. In production: `wrangler secret put PROXY_SECRET --env production`.
PROXY_SECRET=

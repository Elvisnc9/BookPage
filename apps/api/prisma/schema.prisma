// BookPage core data model.
//
// One business profile is the single source of truth: the booking page, the
// availability engine and (later) the AI all read from it.
//
// Field visibility, marked on each field:
//   [public]  may appear on the booking page
//   [private] used by booking logic, never rendered
//   [owner]   only ever shown to the owner in the dashboard
// Money is stored in minor units (cents) with an ISO 4217 currency code.
// Times of day are minutes from midnight in the business's own time zone;
// instants (bookings) are timestamptz.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ─── Owners & auth ──────────────────────────────────────────────────────────

model User {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// [owner] Clerk's user id (user_…). Clerk owns sign-in, sessions and cookies; set on first sign-in.
  clerkUserId String?  @unique @map("clerk_user_id")
  email       String   @unique /// [owner] primary email from Clerk, lower-cased
  name        String? /// [owner]
  avatarUrl   String?  @map("avatar_url") /// [owner]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  businesses Business[]

  @@map("users")
}

// ─── Business profile ───────────────────────────────────────────────────────

enum LocationType {
  premises /// customers come to the business
  mobile /// the business travels to customers
  both
  online

  @@map("location_type")
}

model Business {
  id          String  @id @default(uuid(7)) @db.Uuid
  ownerId     String  @map("owner_id") @db.Uuid /// [owner]
  slug        String  @unique /// [public] subdomain; see RESERVED_SLUGS in @bookpage/shared
  name        String /// [public]
  category    String? /// [public] e.g. "hair_salon", "barber", "tutor"
  description String? /// [public]

  locationType LocationType @default(premises) @map("location_type") /// [public]
  addressLine1 String?      @map("address_line1") /// [public]
  addressLine2 String?      @map("address_line2") /// [public]
  city         String? /// [public]
  region       String? /// [public] state / county / province
  postalCode   String?      @map("postal_code") /// [public]
  country      String       @default("US") @db.Char(2) /// [public] ISO 3166-1 alpha-2
  serviceAreas String[]     @default([]) @map("service_areas") /// [public] for mobile businesses

  phone    String? /// [public] E.164
  whatsapp String? /// [public] E.164
  email    String? /// [public] contact email shown on the page (not the owner's login)

  /// [public] the website template; null = never picked, renders Classic.
  /// Templates are retired with isActive, never deleted, hence Restrict.
  templateId String?       @map("template_id") @db.Uuid
  template   SiteTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// [public] owner's colour/font on top of the template's defaultTheme: { accent?, font? }
  theme      Json          @default("{}")

  timezone String @default("America/New_York") /// [private] IANA zone, detected at onboarding
  currency String @default("USD") @db.Char(3) /// [public] ISO 4217
  locale   String @default("en") /// [private]

  onboardingStep Int       @default(0) @map("onboarding_step") /// [owner] 0–5 (About … Publish)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3) /// [owner] page is live when set
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  hours        OpeningHours[]
  services     Service[]
  staff        Staff[]
  bookingRules BookingRules?
  customers    Customer[]
  bookings     Booking[]
  enquiries    Enquiry[]
  faqs         Faq[]
  media        MediaAsset[]

  @@index([ownerId])
  @@index([templateId])
  @@map("businesses")
}

enum HoursKind {
  opening /// shown on the page
  booking /// when bookings may start; only used when BookingRules.useOpeningHours is false

  @@map("hours_kind")
}

/// A day may have several ranges (e.g. 9–13 and 14–18). A day with no rows is closed.
model OpeningHours {
  id         String    @id @default(uuid(7)) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  kind       HoursKind @default(opening)
  weekday    Int /// [public] ISO weekday, 1 = Monday … 7 = Sunday
  opensAt    Int       @map("opens_at") /// [public] minutes from midnight
  closesAt   Int       @map("closes_at") /// [public] minutes from midnight, > opensAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, kind, weekday])
  @@map("opening_hours")
}

// ─── Services & staff ───────────────────────────────────────────────────────

enum PriceType {
  fixed
  from
  quote /// sends an enquiry, never a booking
  free

  @@map("price_type")
}

model Service {
  id          String    @id @default(uuid(7)) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  name        String /// [public]
  description String? /// [public]
  priceType   PriceType @default(fixed) @map("price_type") /// [public]
  priceMinor  Int?      @map("price_minor") /// [public] null for quote/free
  durationMin Int       @map("duration_min") /// [public]
  bufferMin   Int       @default(0) @map("buffer_min") /// [private] gap kept free after each booking
  bookable    Boolean   @default(true) /// [public] false = shown on the page but enquiry only
  /// [public] deposit to pay before the booking is confirmed; null = none. Only applies
  /// when BookingRules.depositUrl is set. BookPage never touches the money: the customer
  /// pays through the owner's own payment link and the owner confirms receipt.
  depositMinor Int?     @map("deposit_minor")
  position    Int       @default(0) /// [public] display order
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3) /// [owner] hidden, kept for past bookings
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff     StaffService[]
  bookings  Booking[]
  enquiries Enquiry[]
  media     MediaAsset[]

  @@index([businessId, position])
  @@map("services")
}

/// Every business has at least one staff member (the owner, created at onboarding),
/// so every booking belongs to someone's calendar and the overlap guard always applies.
model Staff {
  id         String    @id @default(uuid(7)) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String /// [public]
  position   Int       @default(0) /// [public]
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3) /// [owner]
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services StaffService[]
  bookings Booking[]
  media    MediaAsset[]

  @@index([businessId])
  @@map("staff")
}

model StaffService {
  staffId   String @map("staff_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
  @@map("staff_services")
}

// ─── Booking rules ──────────────────────────────────────────────────────────

/// One row per business. All [private]: they shape availability but aren't shown.
model BookingRules {
  businessId      String   @id @map("business_id") @db.Uuid
  useOpeningHours Boolean  @default(true) @map("use_opening_hours") /// false = use OpeningHours rows of kind "booking"
  minNoticeMin    Int      @default(120) @map("min_notice_min") /// earliest bookable start = now + notice
  windowDays      Int      @default(60) @map("window_days") /// how far ahead customers can book
  slotStepMin     Int      @default(15) @map("slot_step_min") /// start times offered every N minutes
  autoConfirm     Boolean  @default(true) @map("auto_confirm") /// false = bookings start as pending
  /// Which customer details to ask for: { phone: "required"|"optional"|"off", email: …, note: … }
  customerFields  Json     @default("{\"phone\":\"required\",\"email\":\"required\",\"note\":\"optional\"}") @map("customer_fields")
  alertChannels   String[] @default(["email"]) @map("alert_channels") /// owner alerts; MVP: "email"
  depositUrl         String? @map("deposit_url") /// the owner's own payment link (Stripe Payment Link, PayPal.me…); https only
  depositHoldMin     Int     @default(120) @map("deposit_hold_min") /// how long an unpaid deposit holds the slot
  depositRefundHours Int     @default(24) @map("deposit_refund_hours") /// refund promised if the customer cancels this far ahead
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("booking_rules")
}

// ─── Customers, bookings, enquiries ─────────────────────────────────────────

/// Customers never sign up; a row is created per business the first time they book.
/// All fields [owner]. GDPR erasure blanks the personal fields and sets anonymizedAt,
/// keeping the bookings for the owner's records.
model Customer {
  id                 String    @id @default(uuid(7)) @db.Uuid
  businessId         String    @map("business_id") @db.Uuid
  name               String
  email              String? /// lower-cased
  phone              String? /// E.164
  remindersConsentAt DateTime? @map("reminders_consent_at") @db.Timestamptz(3) /// when they agreed to reminder emails
  anonymizedAt       DateTime? @map("anonymized_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  enquiries Enquiry[]

  @@unique([businessId, email])
  @@index([businessId, phone])
  @@map("customers")
}

enum BookingStatus {
  pending /// waiting for the owner (auto_confirm off) — holds the slot
  confirmed /// holds the slot
  cancelled
  completed
  no_show

  @@map("booking_status")
}

enum BookingSource {
  page /// customer booked on the booking page
  owner /// owner added it from the dashboard

  @@map("booking_source")
}

/// No two pending/confirmed bookings for the same staff member may overlap on
/// [startsAt, blockedUntil). Enforced by the `bookings_no_overlap` exclusion
/// constraint added in raw SQL in the init migration (Prisma can't express it).
model Booking {
  id           String        @id @default(uuid(7)) @db.Uuid
  businessId   String        @map("business_id") @db.Uuid
  serviceId    String        @map("service_id") @db.Uuid
  staffId      String        @map("staff_id") @db.Uuid
  customerId   String        @map("customer_id") @db.Uuid
  status       BookingStatus @default(confirmed)
  source       BookingSource @default(page)
  startsAt     DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime      @map("ends_at") @db.Timestamptz(3) /// startsAt + duration; what the customer sees
  blockedUntil DateTime      @map("blocked_until") @db.Timestamptz(3) /// endsAt + buffer; what the overlap guard uses

  // Snapshot of the service at booking time, so later edits don't rewrite history.
  serviceName String    @map("service_name")
  durationMin Int       @map("duration_min")
  priceType   PriceType @map("price_type")
  priceMinor  Int?      @map("price_minor")
  currency    String    @db.Char(3)

  customerNote    String?   @map("customer_note") /// [owner]
  manageTokenHash String?   @unique @map("manage_token_hash") /// [private] customer's cancel link
  reminderSentAt  DateTime? @map("reminder_sent_at") @db.Timestamptz(3)
  /// Deposit snapshot. A booking with a deposit starts pending; the owner confirms when the
  /// money arrives (sets depositPaidAt), or the hold lapses at depositDueAt and the slot frees.
  depositMinor    Int?      @map("deposit_minor")
  depositDueAt    DateTime? @map("deposit_due_at") @db.Timestamptz(3)
  depositPaidAt   DateTime? @map("deposit_paid_at") @db.Timestamptz(3)
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason    String?   @map("cancel_reason") /// [owner]
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([businessId, startsAt])
  @@index([staffId, startsAt])
  @@index([customerId])
  @@index([status, startsAt]) // reminder cron: confirmed bookings starting tomorrow
  @@index([status, depositDueAt]) // deposit cron: unpaid holds that have lapsed
  @@map("bookings")
}

enum EnquiryStatus {
  new
  replied
  closed

  @@map("enquiry_status")
}

/// Quote-only services (and unbookable ones) create an enquiry instead of a booking.
model Enquiry {
  id            String        @id @default(uuid(7)) @db.Uuid
  businessId    String        @map("business_id") @db.Uuid
  serviceId     String?       @map("service_id") @db.Uuid
  customerId    String        @map("customer_id") @db.Uuid
  message       String /// [owner]
  preferredDate DateTime?     @map("preferred_date") @db.Date /// [owner]
  status        EnquiryStatus @default(new)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([businessId, status, createdAt])
  @@map("enquiries")
}

// ─── FAQs (read by the AI later; only approved ones) ────────────────────────

model Faq {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  question   String /// [public] once approved
  answer     String /// [public] once approved
  approved   Boolean  @default(false)
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, position])
  @@map("faqs")
}

// ─── Website templates & media ──────────────────────────────────────────────

/// What templates exist and which are offered. The database decides availability,
/// order and defaults; the web app's code registry (keyed by slug) decides how a
/// template is drawn. Rows hold data only and are validated with zod
/// (@bookpage/shared parseTemplate) before anything renders them.
model SiteTemplate {
  id                  String   @id @default(uuid(7)) @db.Uuid
  slug                String   @unique /// registry key in apps/web/src/site/registry.ts
  name                String
  description         String
  category            String /// TEMPLATE_GROUPS key: beauty, food, fitness, creative, professional, retail, home
  thumbnailUrl        String?  @map("thumbnail_url") /// optional static card image; the gallery renders a live sample otherwise
  previewImageUrl     String?  @map("preview_image_url")
  version             Int      @default(1) /// bumped when the template's look changes
  isActive            Boolean  @default(true) @map("is_active") /// false = retired: not offered, pages fall back to Classic with a notice
  isPremium           Boolean  @default(false) @map("is_premium")
  supportedSections   String[] @map("supported_sections")
  defaultTheme        Json     @map("default_theme") /// { accent: "#RRGGBB", font }
  layoutConfiguration Json     @map("layout_configuration") /// LayoutConfig for schemaVersion
  schemaVersion       Int      @default(1) @map("schema_version")
  position            Int      @default(0) /// gallery order
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  businesses Business[]

  @@index([isActive, position])
  @@map("site_templates")
}

enum MediaKind {
  logo
  hero
  gallery
  service /// one per service (serviceId)
  staff /// one per person (staffId)

  @@map("media_kind")
}

/// Uploaded images, resized and re-encoded in the browser, stored here until object
/// storage exists. Served (immutable) at /media/{id}. [public] once attached.
model MediaAsset {
  id          String    @id @default(uuid(7)) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  kind        MediaKind
  serviceId   String?   @map("service_id") @db.Uuid
  staffId     String?   @map("staff_id") @db.Uuid
  contentType String    @map("content_type")
  width       Int?
  height      Int?
  byteSize    Int       @map("byte_size")
  data        Bytes
  position    Int       @default(0) /// gallery order
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff    Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([businessId, kind, position])
  @@index([serviceId])
  @@index([staffId])
  @@map("media_assets")
}

// ─── Marketing ──────────────────────────────────────────────────────────────

/// People who asked to hear when Pro launches. Emailed once, about that only.
model WaitlistEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String /// lower-cased
  kind      String   @default("pro")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([email, kind])
  @@map("waitlist")
}

PORT=3000
# The owner app. Browsers reach the API only through ${APP_ORIGIN}/api/* (proxied by apps/web).
APP_ORIGIN=http://localhost:4321

# Neon: pooled connection (host contains -pooler) for the app at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# Neon: direct connection (no -pooler) for migrations.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Google OAuth web client. Redirect URI: ${APP_ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret the web app sends with the visitor's IP (x-bookpage-client-ip) so rate limits
# key on the visitor, not the Worker. Same value as PROXY_SECRET in apps/web. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Unset: forwarded IPs are ignored and every booking-page visitor shares the Worker's limit.
PROXY_SECRET=

# Email (Resend). Unset in dev: emails are logged instead of sent.
RESEND_API_KEY=
# Sender address on your verified Resend domain. Customer emails show "<Business> via BookPage".
EMAIL_FROM=bookings@mail.bookpage.app
# Booking-page origin used in email links. Dev: http://{slug}.localhost:4321
PAGE_URL_TEMPLATE=https://{slug}.bookpage.app
# Signs the "change or cancel" links in emails. Required in production. Generate like PROXY_SECRET.
MANAGE_TOKEN_SECRET=
# Set to false on extra API instances if you run more than one (the job is safe either way).
REMINDERS_ENABLED=true

# Local only: shows a developer sign-in (no Google needed). Ignored in production.
DEV_LOGIN=false
